          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматичні посилання на телефони, адреси, дати.\nНатисніть для дзвінка, карти або додавання події."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
