          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppelt automatisch telefoons, adressen, datums.\nTik om te bellen, kaart te openen of afspraak toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatycznie linkuje telefony, adresy, daty.\nDotknij, aby zadzwonić, otworzyć mapę lub dodać wydarzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincula automaticamente telefones, endereços, datas.\nToque para ligar, mapear ou adicionar evento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liga automaticamente telefones, moradas, datas.\nToque para ligar, ver mapa ou adicionar evento."
          }
        },
        "ro" : {
          "stringUnit" : {
