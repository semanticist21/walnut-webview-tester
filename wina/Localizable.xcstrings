    "Currently active cores.\nMay throttle based on:\nThermal state, Low Power Mode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النوى النشطة حاليًا.\nقد تتغير حسب الحرارة أو وضع الطاقة المنخفضة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
