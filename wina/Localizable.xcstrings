    "Codec support may vary depending on device and OS version." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يختلف دعم برامج الترميز حسب الجهاز وإصدار نظام التشغيل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El suport de còdecs pot variar segons el dispositiu i la versió del SO."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podpora kodeků se může lišit v závislosti na zařízení a verzi OS."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codec-understøttelse kan variere afhængigt af enhed og OS-version."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Codec-Unterstützung kann je nach Gerät und OS-Version variieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η υποστήριξη κωδικοποιητών μπορεί να διαφέρει ανάλογα με τη συσκευή και την έκδοση OS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El soporte de códecs puede variar según el dispositivo y la versión del SO."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodekkituki voi vaihdella laitteen ja käyttöjärjestelmäversion mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prise en charge des codecs peut varier selon l'appareil et la version de l'OS."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תמיכה בקודקים עשויה להשתנות בהתאם למכשיר ולגרסת מערכת ההפעלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोडेक समर्थन डिवाइस और OS संस्करण के अनुसार भिन्न हो सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrška za kodeke može varirati ovisno o uređaju i verziji OS-a."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kodek támogatás az eszköztől és az operációs rendszer verziójától függően változhat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dukungan codec dapat bervariasi tergantung pada perangkat dan versi OS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il supporto codec può variare a seconda del dispositivo e della versione del SO."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コーデックのサポートはデバイスとOSバージョンによって異なる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코덱 지원은 기기와 OS 버전에 따라 달라집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sokongan codec mungkin berbeza bergantung pada peranti dan versi OS."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodek-støtte kan variere avhengig av enhet og OS-versjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codec-ondersteuning kan variëren afhankelijk van apparaat en OS-versie."
