    "navigator.hardwareConcurrency.\nJS thread pool sizing.\nMay differ from actual CPU cores\nfor privacy protection." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "navigator.hardwareConcurrency.\nقد يختلف عن النوى الفعلية للخصوصية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "navigator.hardwareConcurrency.\nPot diferir dels nuclis reals per privacitat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "navigator.hardwareConcurrency.\nMůže se lišit od skutečných jader pro soukromí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "navigator.hardwareConcurrency.\nKan afvige fra faktiske kerner af hensyn til privatliv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "navigator.hardwareConcurrency.\nKann aus Datenschutzgründen von tatsächlichen Kernen abweichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "navigator.hardwareConcurrency.\nΜπορεί να διαφέρει από τους πραγματικούς πυρήνες για απόρρητο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "navigator.hardwareConcurrency.\nPuede diferir de los núcleos reales por privacidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "navigator.hardwareConcurrency.\nVoi erota todellisista ytimistä yksityisyyden vuoksi."
          }
        },
        "fr" : {
