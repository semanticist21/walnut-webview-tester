    "Only colors and dismiss button style can be changed. Cannot add custom toolbar items." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن تغيير الألوان ونمط زر الإغلاق فقط. لا يمكن إضافة عناصر شريط أدوات مخصصة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només es poden canviar els colors i l'estil del botó de tancar. No es poden afegir elements de barra d'eines personalitzats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lze změnit pouze barvy a styl tlačítka zavřít. Nelze přidat vlastní položky panelu nástrojů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun farver og stil på luk-knappen kan ændres. Kan ikke tilføje brugerdefinerede værktøjslinjeelementer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Farben und Schließen-Button anpassbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο τα χρώματα και το στυλ του κουμπιού κλεισίματος μπορούν να αλλάξουν. Δεν είναι δυνατή η προσθήκη προσαρμοσμένων στοιχείων γραμμής εργαλείων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo colores y botón cerrar personalizables."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain värejä ja sulje-painikkeen tyyliä voidaan muuttaa. Mukautettuja työkalupalkin kohteita ei voi lisätä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls couleurs et bouton fermer modifiables."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניתן לשנות רק צבעים וסגנון כפתור הסגירה. לא ניתן להוסיף פריטי סרגל כלים מותאמים אישית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल रंग और बंद करें बटन शैली बदली जा सकती है। कस्टम टूलबार आइटम नहीं जोड़े जा सकते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mogu se promijeniti samo boje i stil gumba za zatvaranje. Nije moguće dodati prilagođene stavke alatne trake."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak a színek és a bezárás gomb stílusa módosítható. Egyéni eszköztár elemek nem adhatók hozzá."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya warna dan gaya tombol tutup yang dapat diubah. Tidak dapat menambahkan item toolbar kustom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo colori e pulsante chiudi modificabili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色と閉じるボタンのスタイルのみ変更可能です。カスタムツールバー項目は追加できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "색상과 닫기 버튼 스타일만 변경할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya warna dan gaya butang tutup boleh diubah. Tidak boleh menambah item bar alat tersuai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun farger og stil på lukk-knappen kan endres. Kan ikke legge til egendefinerte verktøylinjeelementer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen kleuren en de stijl van de sluitknop kunnen worden gewijzigd. Aangepaste werkbalkitems kunnen niet worden toegevoegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Można zmienić tylko kolory i styl przycisku zamknięcia. Nie można dodać niestandardowych elementów paska narzędzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas cores e estilo do botão de fechar podem ser alterados. Não é possível adicionar itens de barra de ferramentas personalizados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas cores e estilo do botão de fechar podem ser alterados. Não é possível adicionar itens de barra de ferramentas personalizados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doar culorile și stilul butonului de închidere pot fi schimbate. Nu se pot adăuga elemente personalizate în bara de instrumente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только цвета и кнопка закрытия настраиваемы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možno zmeniť iba farby a štýl tlačidla zavrieť. Nie je možné pridať vlastné položky panela nástrojov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast färger och stäng-knappens stil kan ändras. Kan inte lägga till anpassade verktygsfältsobjekt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สามารถเปลี่ยนสีและสไตล์ปุ่มปิดได้เท่านั้น ไม่สามารถเพิ่มรายการแถบเครื่องมือที่กำหนดเองได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca renkler ve kapat düğmesi stili değiştirilebilir. Özel araç çubuğu öğeleri eklenemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можна змінити лише кольори та стиль кнопки закриття. Користувацькі елементи панелі інструментів додати не можна."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ có thể thay đổi màu sắc và kiểu nút đóng. Không thể thêm các mục thanh công cụ tùy chỉnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只能更改颜色和关闭按钮样式。无法添加自定义工具栏项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只能更改顏色和關閉按鈕樣式。無法新增自訂工具列項目。"
          }
        }
      }
    },
    "Only in Safari or home screen web apps." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط في Safari أو تطبيقات الويب على الشاشة الرئيسية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només a Safari o apps web de la pantalla d'inici."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouze v Safari nebo ve webových aplikacích na ploše."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun i Safari eller web-apps på startskærmen."
          }
