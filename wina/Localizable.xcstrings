    "iPad: Full drag/drop support.\nBetween apps, within app.\nSplit View compatible." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: دعم كامل للسحب والإفلات.\nبين التطبيقات وداخل التطبيق.\nمتوافق مع Split View."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Suport complet d'arrossegar i deixar anar.\nEntre aplicacions i dins l'aplicació.\nCompatible amb Split View."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Plná podpora přetahování.\nMezi aplikacemi a v aplikaci.\nKompatibilní s Split View."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Fuld træk og slip-understøttelse.\nMellem apps og inden for appen.\nSplit View kompatibel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Vollständiges Drag & Drop."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Πλήρης υποστήριξη μεταφοράς και απόθεσης.\nΜεταξύ εφαρμογών και εντός της εφαρμογής.\nΣυμβατό με Split View."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Arrastrar/soltar completo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Täysi vedä ja pudota -tuki.\nSovellusten välillä ja sovelluksessa.\nSplit View -yhteensopiva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad : Glisser-déposer complet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: תמיכה מלאה בגרירה ושחרור.\nבין אפליקציות ובתוך האפליקציה.\nתואם Split View."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: पूर्ण ड्रैग/ड्रॉप समर्थन।\nऐप्स के बीच और ऐप के भीतर।\nSplit View संगत।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Puna podrška za povuci i ispusti.\nIzmeđu aplikacija i unutar aplikacije.\nKompatibilno sa Split View."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Teljes húzd és ejtsd támogatás.\nAlkalmazások között és alkalmazáson belül.\nSplit View kompatibilis."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Dukungan seret dan lepas penuh.\nAntar aplikasi dan dalam aplikasi.\nKompatibel dengan Split View."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Drag & drop completo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: フルドラッグ＆ドロップ対応。\nアプリ間、アプリ内で使用可能。\nSplit View対応。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad에서 전체 드래그/드롭을 지원합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Sokongan seret dan lepas penuh.\nAntara aplikasi dan dalam aplikasi.\nSerasi dengan Split View."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Full dra og slipp-støtte.\nMellom apper og innenfor appen.\nSplit View kompatibel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Volledige drag & drop ondersteuning.\nTussen apps en binnen de app.\nSplit View compatibel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Pełna obsługa przeciągania i upuszczania.\nMiędzy aplikacjami i w aplikacji.\nKompatybilny z Split View."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Suporte completo a arrastar e soltar.\nEntre apps e dentro do app.\nCompatível com Split View."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Suporte completo de arrastar e largar.\nEntre apps e dentro da app.\nCompatível com Split View."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Suport complet pentru drag and drop.\nÎntre aplicații și în cadrul aplicației.\nCompatibil cu Split View."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Полная поддержка перетаскивания."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Plná podpora presúvania.\nMedzi aplikáciami a v aplikácii.\nKompatibilné so Split View."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Fullt stöd för dra och släpp.\nMellan appar och i appen.\nSplit View-kompatibel."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: รองรับลากและวางเต็มรูปแบบ\nระหว่างแอปและภายในแอป\nรองรับ Split View"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Tam sürükle-bırak desteği.\nUygulamalar arası ve uygulama içi.\nSplit View uyumlu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Повна підтримка перетягування.\nМіж додатками та всередині додатку.\nСумісно з Split View."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
