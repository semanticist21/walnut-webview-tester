          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membenarkan zum cubit walaupun halaman melumpuhkannya melalui tag meta viewport."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillater klypezoom selv når siden deaktiverer det via viewport meta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staat pinch-to-zoom toe zelfs als de pagina het uitschakelt via viewport meta."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwala na pinch-to-zoom nawet gdy strona wyłącza to przez meta viewport."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite zoom por pinça mesmo quando a página desabilita via meta viewport."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite zoom por pinça mesmo quando a página desativa via meta viewport."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
