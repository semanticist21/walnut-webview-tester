    "Videos play automatically.\nOff = Tap to play videos.\nSaves battery and data." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشغيل الفيديوهات تلقائيًا.\nإيقاف = انقر للتشغيل.\nيوفر البطارية والبيانات."
          }
        },
        "ca" : {
