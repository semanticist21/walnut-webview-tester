    "Auto-secure connections.\nHTTP → HTTPS upgrade.\nProtects your data." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتصالات آمنة تلقائيًا.\nترقية HTTP → HTTPS.\nيحمي بياناتك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexions auto-segures.\nActualització HTTP → HTTPS.\nProtegeix les teves dades."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky zabezpečená připojení.\nUpgrade HTTP → HTTPS.\nChrání vaše data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-sikre forbindelser.\nHTTP → HTTPS opgradering.\nBeskytter dine data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-sichere Verbindungen.\nHTTP → HTTPS Upgrade.\nSchützt Ihre Daten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτόματα ασφαλείς συνδέσεις.\nΑναβάθμιση HTTP → HTTPS.\nΠροστατεύει τα δεδομένα σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexiones auto-seguras.\nActualización HTTP → HTTPS.\nProtege tus datos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaattisesti suojatut yhteydet.\nHTTP → HTTPS päivitys.\nSuojaa tietojasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexions auto-sécurisées.\nMise à niveau HTTP → HTTPS.\nProtège vos données."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חיבורים מאובטחים אוטומטית.\nשדרוג HTTP → HTTPS.\nמגן על הנתונים שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑटो-सुरक्षित कनेक्शन।\nHTTP → HTTPS अपग्रेड।\nआपके डेटा की सुरक्षा करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatski sigurne veze.\nHTTP → HTTPS nadogradnja.\nŠtiti vaše podatke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatikusan biztonságos kapcsolatok.\nHTTP → HTTPS frissítés.\nVédi az adatait."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneksi aman otomatis.\nUpgrade HTTP → HTTPS.\nMelindungi data Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connessioni auto-sicure.\nAggiornamento HTTP → HTTPS.\nProtegge i tuoi dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続を自動保護。\nHTTP → HTTPSにアップグレード。\nデータを保護します。"
          }
        },
        "ko" : {
