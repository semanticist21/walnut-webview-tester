    "Screen recording was denied or is not available. Please enable screen recording permission in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم رفض تسجيل الشاشة أو أنه غير متاح. يرجى تمكين إذن تسجيل الشاشة في الإعدادات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enregistrament de pantalla s'ha denegat o no està disponible. Activeu el permís d'enregistrament de pantalla a Configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahrávání obrazovky bylo odmítnuto nebo není dostupné. Povolte prosím oprávnění pro nahrávání obrazovky v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skærmoptagelse blev afvist eller er ikke tilgængelig. Aktivér venligst tilladelse til skærmoptagelse i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirmaufnahme wurde verweigert oder ist nicht verfügbar. Bitte aktivieren Sie die Berechtigung für Bildschirmaufnahmen in den Einstellungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εγγραφή οθόνης απορρίφθηκε ή δεν είναι διαθέσιμη. Ενεργοποιήστε την άδεια εγγραφής οθόνης στις Ρυθμίσεις."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen recording was denied or is not available. Please enable screen recording permission in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación de pantalla fue denegada o no está disponible. Por favor, habilite el permiso de grabación de pantalla en Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytön tallennus evättiin tai ei ole käytettävissä. Ota näytön tallennusoikeus käyttöön Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enregistrement d'écran a été refusé ou n'est pas disponible. Veuillez activer l'autorisation d'enregistrement d'écran dans Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקלטת מסך נדחתה או אינה זמינה. אנא הפעל הרשאת הקלטת מסך בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रीन रिकॉर्डिंग अस्वीकृत हो गई या उपलब्ध नहीं है। कृपया सेटिंग्स में स्क्रीन रिकॉर्डिंग अनुमति सक्षम करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snimanje zaslona je odbijeno ili nije dostupno. Omogućite dopuštenje za snimanje zaslona u Postavkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A képernyőfelvétel elutasításra került vagy nem elérhető. Kérjük, engedélyezze a képernyőfelvétel jogosultságot a Beállításokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perekaman layar ditolak atau tidak tersedia. Harap aktifkan izin perekaman layar di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione dello schermo è stata negata o non è disponibile. Abilita l'autorizzazione alla registrazione dello schermo nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面収録が拒否されたか、利用できません。設定で画面収録の許可を有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 녹화가 거부되었거나 사용할 수 없습니다. 설정에서 화면 녹화 권한을 활성화해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakaman skrin telah ditolak atau tidak tersedia. Sila dayakan kebenaran rakaman skrin dalam Tetapan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjermopptak ble avslått eller er ikke tilgjengelig. Aktiver tillatelse for skjermopptak i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schermopname is geweigerd of niet beschikbaar. Schakel de toestemming voor schermopname in via Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrywanie ekranu zostało odrzucone lub jest niedostępne. Włącz uprawnienie do nagrywania ekranu w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação de tela foi negada ou não está disponível. Ative a permissão de gravação de tela nos Ajustes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação de ecrã foi negada ou não está disponível. Por favor, ative a permissão de gravação de ecrã nas Definições."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înregistrarea ecranului a fost refuzată sau nu este disponibilă. Vă rugăm să activați permisiunea de înregistrare a ecranului în Setări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись экрана была отклонена или недоступна. Пожалуйста, включите разрешение на запись экрана в Настройках."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahrávanie obrazovky bolo zamietnuté alebo nie je dostupné. Povoľte prosím povolenie na nahrávanie obrazovky v Nastaveniach."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skärminspelning nekades eller är inte tillgänglig. Aktivera behörighet för skärminspelning i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การบันทึกหน้าจอถูกปฏิเสธหรือไม่พร้อมใช้งาน กรุณาเปิดใช้งานสิทธิ์การบันทึกหน้าจอในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran kaydı reddedildi veya kullanılamıyor. Lütfen Ayarlar'dan ekran kaydı iznini etkinleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запис екрана було відхилено або він недоступний. Будь ласка, увімкніть дозвіл на запис екрана в Налаштуваннях."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi màn hình đã bị từ chối hoặc không khả dụng. Vui lòng bật quyền ghi màn hình trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏幕录制被拒绝或不可用。请在设置中启用屏幕录制权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "螢幕錄製被拒絕或無法使用。請在設定中啟用螢幕錄製權限。"
          }
        }
      }
