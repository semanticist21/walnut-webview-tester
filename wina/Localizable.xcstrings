    "Allows pinch-to-zoom even when the page disables it via viewport meta tag." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسمح بالتكبير بالضغط حتى لو عطلته الصفحة عبر علامة meta viewport."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet el zoom de pessic fins i tot quan la pàgina ho desactiva via meta viewport."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoluje přiblížení gesty i když stránka to zakáže přes meta viewport."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillader knib-zoom selvom siden deaktiverer det via viewport meta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignoriert Seiten-Zoom-Einschränkungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέπει ζουμ τσίμπημα ακόμα κι όταν η σελίδα το απενεργοποιεί μέσω viewport meta."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignora restricciones de zoom."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sallii nipistyszoomauksen vaikka sivu poistaa sen käytöstä viewport-metalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignore les restrictions de zoom."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאפשר זום בצביטה גם כשהעמוד משבית אותו דרך meta viewport."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "viewport meta tag के माध्यम से पेज द्वारा अक्षम होने पर भी पिंच-टू-ज़ूम की अनुमति देता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
