          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматические ссылки на телефоны, адреса, даты.\nНажмите для звонка, карты или добавления события."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
