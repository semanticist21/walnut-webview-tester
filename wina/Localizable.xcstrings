    "Allow popup windows.\nOff = Block popups.\nSome sites need this on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السماح بالنوافذ المنبثقة.\nإيقاف = حظر النوافذ المنبثقة.\nبعض المواقع تحتاج هذا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
