    "Persistent key-value storage.\n~5MB limit per website.\nSurvives browser restart." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تخزين مفتاح-قيمة دائم.\nحد حوالي 5 ميجابايت لكل موقع.\nيبقى بعد إعادة تشغيل المتصفح."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emmagatzematge clau-valor persistent.\nLímit d'aproximadament 5MB per lloc web.\nSobreviu al reinici del navegador."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trvalé úložiště klíč-hodnota.\nLimit přibližně 5MB na web.\nPřežije restart prohlížeče."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedvarende nøgle-værdi lagring.\nCa. 5MB grænse pr. websted.\nOverlever browser genstart."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persistenter Schlüssel-Wert-Speicher.\nEtwa 5MB Limit pro Website.\nÜberlebt Browser-Neustart."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνιμη αποθήκευση κλειδιού-τιμής.\nΌριο περίπου 5MB ανά ιστότοπο.\nΕπιβιώνει επανεκκίνησης του προγράμματος περιήγησης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almacenamiento clave-valor persistente.\nLímite de aproximadamente 5MB por sitio web.\nSobrevive al reinicio del navegador."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pysyvä avain-arvo-tallennus.\nNoin 5MB raja sivustoa kohti.\nSäilyy selaimen uudelleenkäynnistyksen yli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stockage clé-valeur persistant.\nLimite d'environ 5Mo par site web.\nSurvit au redémarrage du navigateur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אחסון מפתח-ערך קבוע.\nמגבלה של כ-5MB לאתר.\nשורד הפעלה מחדש של הדפדפן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्थायी कुंजी-मान भंडारण।\nप्रति वेबसाइट लगभग 5MB सीमा।\nब्राउज़र रीस्टार्ट के बाद भी बना रहता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trajna pohrana ključ-vrijednost.\nOgraničenje od oko 5MB po web stranici.\nPreživljava ponovno pokretanje preglednika."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Állandó kulcs-érték tárolás.\nKörülbelül 5MB korlát webhelyenként.\nTúléli a böngésző újraindítását."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyimpanan kunci-nilai persisten.\nBatas sekitar 5MB per situs.\nBertahan setelah browser diulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiviazione chiave-valore persistente.\nLimite di circa 5MB per sito web.\nSopravvive al riavvio del browser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永続的なキー値ストレージです。\nウェブサイトあたり約5MBの制限があります。\nブラウザ再起動後も保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영구 키-값 저장소입니다.\n웹사이트당 약 5MB 제한입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storan kunci-nilai berterusan.\nHad kira-kira 5MB setiap laman web.\nKekal selepas mulakan semula pelayar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedvarende nøkkel-verdi lagring.\nCa. 5MB grense per nettsted.\nOverlever nettleser omstart."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
