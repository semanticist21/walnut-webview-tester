          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stocare cheie-valoare persistentă.\nLimită de aproximativ 5MB per site.\nSupraviețuiește repornirii browserului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
