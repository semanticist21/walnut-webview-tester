    "Game controller input.\nMFi controllers supported.\nPS/Xbox may work too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إدخال وحدة التحكم.\nدعم أذرع MFi.\nPS/Xbox قد يعملان أيضًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrada de comandament de joc.\nControladors MFi compatibles.\nPS/Xbox també poden funcionar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vstup herního ovladače.\nPodporované MFi ovladače.\nPS/Xbox mohou také fungovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spilcontroller-input.\nMFi-controllere understøttes.\nPS/Xbox kan også virke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Game-Controller-Eingabe.\nMFi-Controller unterstützt.\nPS/Xbox funktioniert evtl. auch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είσοδος χειριστηρίου παιχνιδιών.\nΥποστηρίζονται χειριστήρια MFi.\nPS/Xbox μπορεί επίσης να λειτουργούν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrada de mando de juego.\nControladores MFi soportados.\nPS/Xbox también pueden funcionar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peliohjaintulo.\nMFi-ohjaimet tuettu.\nPS/Xbox voivat myös toimia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrée manette de jeu.\nContrôleurs MFi supportés.\nPS/Xbox peuvent aussi fonctionner."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קלט בקר משחק.\nבקרי MFi נתמכים.\nPS/Xbox עשויים גם לעבוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गेम कंट्रोलर इनपुट।\nMFi कंट्रोलर समर्थित।\nPS/Xbox भी काम कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos kontrolera za igre.\nMFi kontroleri podržani.\nPS/Xbox također mogu raditi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Játékvezérlő bemenet.\nMFi vezérlők támogatottak.\nPS/Xbox is működhet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Input pengontrol game.\nPengontrol MFi didukung.\nPS/Xbox mungkin juga berfungsi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Input controller di gioco.\nController MFi supportati.\nPS/Xbox potrebbero funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームコントローラー入力です。\nMFiコントローラーをサポート。\nPS/Xboxも動作する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임 컨트롤러 입력입니다.\nMFi 컨트롤러를 지원합니다.\nPS/Xbox도 작동할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Input pengawal permainan.\nPengawal MFi disokong.\nPS/Xbox mungkin juga berfungsi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spillkontroller-inngang.\nMFi-kontrollere støttes.\nPS/Xbox kan også fungere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Game controller-invoer.\nMFi-controllers ondersteund.\nPS/Xbox kunnen ook werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wejście kontrolera gier.\nObsługiwane kontrolery MFi.\nPS/Xbox też mogą działać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrada de controle de jogo.\nControladores MFi suportados.\nPS/Xbox também podem funcionar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrada de comando de jogo.\nControladores MFi suportados.\nPS/Xbox também podem funcionar."
          }
        },
        "ro" : {
