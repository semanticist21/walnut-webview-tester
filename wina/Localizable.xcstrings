    "Unified input events.\nMouse, touch, pen combined.\nModern event handling." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحداث إدخال موحدة.\nالماوس، اللمس، القلم مجتمعة.\nمعالجة أحداث حديثة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esdeveniments d'entrada unificats.\nRatolí, tàctil, llapis combinats.\nGestió moderna d'esdeveniments."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjednocené vstupní události.\nMyš, dotyk, pero kombinované.\nModerní zpracování událostí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forenede inputhændelser.\nMus, touch, pen kombineret.\nModern hændelseshåndtering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vereinheitlichte Eingabeereignisse.\nMaus, Touch, Stift kombiniert.\nModerne Ereignisbehandlung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενοποιημένα συμβάντα εισόδου.\nΠοντίκι, αφή, γραφίδα συνδυασμένα.\nΣύγχρονη διαχείριση συμβάντων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventos de entrada unificados.\nRatón, táctil, lápiz combinados.\nManejo moderno de eventos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistetyt syötetapahtumat.\nHiiri, kosketus, kynä yhdistetty.\nModerni tapahtumakäsittely."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Événements d'entrée unifiés.\nSouris, tactile, stylet combinés.\nGestion moderne des événements."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אירועי קלט מאוחדים.\nעכבר, מגע, עט משולבים.\nטיפול מודרני באירועים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एकीकृत इनपुट इवेंट।\nमाउस, टच, पेन संयुक्त।\nआधुनिक इवेंट हैंडलिंग।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujedinjeni ulazni događaji.\nMiš, dodir, olovka kombinirani.\nModerna obrada događaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egységesített bemeneti események.\nEgér, érintés, toll kombinálva.\nModern eseménykezelés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peristiwa input terpadu.\nMouse, sentuh, pena digabungkan.\nPenanganan peristiwa modern."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventi di input unificati.\nMouse, touch, penna combinati.\nGestione eventi moderna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "統合入力イベントです。\nマウス、タッチ、ペンを統合。\n最新のイベント処理方式。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통합 입력 이벤트입니다.\n마우스, 터치, 펜을 결합합니다.\n최신 이벤트 처리 방식입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peristiwa input bersatu.\nTetikus, sentuh, pen digabungkan.\nPengendalian peristiwa moden."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samlede inndatahendelser.\nMus, touch, penn kombinert.\nModern hendelseshåndtering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniforme invoergebeurtenissen.\nMuis, touch, pen gecombineerd.\nModerne gebeurtenisafhandeling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujednolicone zdarzenia wejściowe.\nMysz, dotyk, rysik połączone.\nNowoczesna obsługa zdarzeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventos de entrada unificados.\nMouse, toque, caneta combinados.\nTratamento moderno de eventos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventos de entrada unificados.\nRato, toque, caneta combinados.\nTratamento moderno de eventos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evenimente de intrare unificate.\nMouse, touch, stilou combinate.\nGestionare modernă a evenimentelor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Унифицированные события ввода.\nМышь, касание, перо объединены.\nСовременная обработка событий."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zjednotené vstupné udalosti.\nMyš, dotyk, pero kombinované.\nModerné spracovanie udalostí."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enhetliga inmatningshändelser.\nMus, touch, penna kombinerade.\nModern händelsehantering."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เหตุการณ์อินพุตแบบรวม\nรวมเมาส์ ทัช ปากกา\nการจัดการเหตุการณ์ที่ทันสมัย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birleşik giriş olayları.\nFare, dokunma, kalem birleşik.\nModern olay işleme."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уніфіковані події введення.\nМиша, дотик, перо об'єднані.\nСучасна обробка подій."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sự kiện đầu vào hợp nhất.\nChuột, chạm, bút kết hợp.\nXử lý sự kiện hiện đại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "统一输入事件。\n鼠标、触摸、笔结合。\n现代事件处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "統一輸入事件。\n滑鼠、觸控、筆結合。\n現代事件處理。"
          }
        }
      }
