    "Auto-link special content.\nPhone numbers, addresses, dates.\nTap to call, map, or add event." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ربط تلقائي للهواتف والعناوين والتواريخ.\nانقر للاتصال أو عرض الخريطة أو إضافة حدث."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enllaça automàticament telèfons, adreces, dates.\nToca per trucar, mapa o afegir esdeveniment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatické propojení telefonů, adres, dat.\nKlepnutím zavoláte, otevřete mapu nebo přidáte událost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autolink til telefoner, adresser, datoer.\nTryk for at ringe, kort eller tilføje begivenhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatische Verknüpfung von Telefonnummern, Adressen, Daten.\nAntippen zum Anrufen, Karte oder Termin hinzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτόματη σύνδεση τηλεφώνων, διευθύνσεων, ημερομηνιών.\nΠατήστε για κλήση, χάρτη ή προσθήκη συμβάντος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enlace automático de teléfonos, direcciones, fechas.\nToca para llamar, ver mapa o agregar evento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaattinen linkitys puhelimiin, osoitteisiin, päivämääriin.\nNapauta soittaaksesi, karttaa tai lisätäksesi tapahtuman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lien automatique pour téléphones, adresses, dates.\nAppuyez pour appeler, localiser ou ajouter un événement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קישור אוטומטי לטלפונים, כתובות, תאריכים.\nהקש להתקשר, מפה או להוסיף אירוע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोन नंबर, पते, तारीखों को स्वचालित लिंक करता है।\nकॉल, मैप या इवेंट जोड़ने के लिए टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatski povezuje telefone, adrese, datume.\nDodirnite za poziv, kartu ili dodavanje događaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatikus link telefonokhoz, címekhez, dátumokhoz.\nKoppintson híváshoz, térképhez vagy esemény hozzáadásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tautan otomatis telepon, alamat, tanggal.\nKetuk untuk menelepon, peta, atau menambah acara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega automaticamente telefoni, indirizzi, date.\nTocca per chiamare, mappa o aggiungere evento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電話番号、住所、日付を自動リンクします。\nタップで直接実行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전화번호, 주소, 날짜를 자동 링크합니다.\n탭하여 바로 실행할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pautan automatik telefon, alamat, tarikh.\nKetik untuk menelefon, peta atau menambah acara."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
