          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trvalé úložisko kľúč-hodnota.\nLimit približne 5MB na web.\nPrežije reštart prehliadača."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beständig nyckel-värde lagring.\nCa 5MB gräns per webbplats.\nÖverlever omstart av webbläsaren."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่เก็บคีย์-ค่าถาวร\nจำกัดประมาณ 5MB ต่อเว็บไซต์\nคงอยู่หลังรีสตาร์ทเบราว์เซอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalıcı anahtar-değer depolaması.\nWeb sitesi başına yaklaşık 5MB sınırı.\nTarayıcı yeniden başlatmasından sonra kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Постійне сховище ключ-значення.\nЛіміт близько 5МБ на сайт.\nЗберігається після перезапуску браузера."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu trữ khóa-giá trị bền vững.\nGiới hạn khoảng 5MB mỗi trang web.\nTồn tại sau khi khởi động lại trình duyệt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持久键值存储。\n每个网站约5MB限制。\n浏览器重启后保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持久鍵值儲存。\n每個網站約5MB限制。\n瀏覽器重啟後保留。"
          }
        }
      }
    },
