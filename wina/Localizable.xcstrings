    "Select and copy text.\nOff = No text selection.\nDisable for game-like pages." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحديد ونسخ النص.\nإيقاف = لا يوجد تحديد نص.\nتعطيل للصفحات الشبيهة بالألعاب."
