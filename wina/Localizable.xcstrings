          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игнорирует ограничения масштабирования."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoľuje priblíženie gestami aj keď stránka to zakáže cez meta viewport."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåter nypzoom även när sidan inaktiverar det via viewport meta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตการซูมแบบหยิกแม้หน้าปิดการใช้งานผ่าน viewport meta tag"
