    "Stream to Apple TV.\nOff = Hide AirPlay button.\nFor local-only playback." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البث إلى Apple TV.\nإيقاف = إخفاء زر AirPlay.\nللتشغيل المحلي فقط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmet a Apple TV.\nDesactivat = Amaga el botó AirPlay.\nNomés reproducció local."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streamovat na Apple TV.\nVypnuto = Skrýt tlačítko AirPlay.\nPouze místní přehrávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stream til Apple TV.\nSlået fra = Skjul AirPlay-knap.\nKun lokal afspilning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An Apple TV streamen.\nAus = AirPlay-Button ausblenden.\nNur für lokale Wiedergabe."
