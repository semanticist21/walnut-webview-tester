    },
    "Settings > Battery toggle.\nReduces CPU/GPU performance.\nDisables background refresh." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإعدادات > مفتاح البطارية.\nيقلل أداء CPU/GPU.\nيعطل التحديث في الخلفية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configuració > Interruptor de bateria.\nReduceix el rendiment de CPU/GPU.\nDesactiva l'actualització en segon pla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení > Přepínač baterie.\nSnižuje výkon CPU/GPU.\nDeaktivuje aktualizaci na pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstillinger > Batterikontakt.\nReducerer CPU/GPU-ydeevne.\nDeaktiverer opdatering i baggrunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen > Batterie-Schalter.\nReduziert CPU/GPU-Leistung.\nDeaktiviert Hintergrundaktualisierung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρυθμίσεις > Διακόπτης μπαταρίας.\nΜειώνει τις επιδόσεις CPU/GPU.\nΑπενεργοποιεί την ανανέωση στο παρασκήνιο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes > Interruptor de batería.\nReduce el rendimiento de CPU/GPU.\nDesactiva la actualización en segundo plano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asetukset > Akkukytkin.\nVähentää CPU/GPU-suorituskykyä.\nPoistaa taustalatauksen käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglages > Basculer Batterie.\nRéduit les performances CPU/GPU.\nDésactive l'actualisation en arrière-plan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדרות > מתג סוללה.\nמפחית ביצועי CPU/GPU.\nמשבית רענון ברקע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग्स > बैटरी टॉगल।\nCPU/GPU प्रदर्शन कम करता है।\nबैकग्राउंड रिफ्रेश अक्षम करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavke > Prekidač baterije.\nSmanjuje performanse CPU/GPU.\nOnemogućuje osvježavanje u pozadini."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beállítások > Akkumulátor kapcsoló.\nCsökkenti a CPU/GPU teljesítményt.\nLetiltja a háttérfrissítést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaturan > Tombol baterai.\nMengurangi performa CPU/GPU.\nMenonaktifkan pembaruan latar belakang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostazioni > Interruttore batteria.\nRiduce le prestazioni CPU/GPU.\nDisabilita l'aggiornamento in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 > バッテリートグルです。\nCPU/GPU性能が低下します。\nバックグラウンド更新が無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 > 배터리 토글입니다.\nCPU/GPU 성능이 감소합니다.\n백그라운드 새로고침이 비활성화됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetapan > Togol bateri.\nMengurangkan prestasi CPU/GPU.\nMenyahdayakan muat semula latar belakang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innstillinger > Batteribryter.\nReduserer CPU/GPU-ytelse.\nDeaktiverer bakgrunnsoppdatering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instellingen > Batterijschakelaar.\nVermindert CPU/GPU-prestaties.\nSchakelt verversing op achtergrond uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia > Przełącznik baterii.\nZmniejsza wydajność CPU/GPU.\nWyłącza odświeżanie w tle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes > Alternância de bateria.\nReduz o desempenho de CPU/GPU.\nDesativa a atualização em segundo plano."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definições > Alternância de bateria.\nReduz o desempenho de CPU/GPU.\nDesativa a atualização em segundo plano."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setări > Comutator baterie.\nReduce performanța CPU/GPU.\nDezactivează reîmprospătarea în fundal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки > Переключатель батареи.\nСнижает производительность CPU/GPU.\nОтключает фоновое обновление."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavenia > Prepínač batérie.\nZnižuje výkon CPU/GPU.\nDeaktivuje aktualizáciu na pozadí."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inställningar > Batteriväxel.\nMinskar CPU/GPU-prestanda.\nInaktiverar bakgrundsuppdatering."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งค่า > สวิตช์แบตเตอรี่\nลดประสิทธิภาพ CPU/GPU\nปิดใช้งานการรีเฟรชพื้นหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar > Pil anahtarı.\nCPU/GPU performansını azaltır.\nArka plan yenilemeyi devre dışı bırakır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштування > Перемикач батареї.\nЗменшує продуктивність CPU/GPU.\nВимикає фонове оновлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt > Công tắc pin.\nGiảm hiệu suất CPU/GPU.\nTắt làm mới nền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置 > 电池开关。\n降低 CPU/GPU 性能。\n禁用后台刷新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 > 電池開關。\n降低 CPU/GPU 效能。\n停用背景重新整理。"
          }
        }
      }
    },
