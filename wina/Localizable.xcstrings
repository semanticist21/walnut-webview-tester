    "Fill, copy, sort arrays.\nMemory bandwidth test.\nCPU cache efficiency." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملء، نسخ، ترتيب المصفوفات.\nاختبار عرض نطاق الذاكرة.\nكفاءة ذاكرة التخزين المؤقت لوحدة المعالجة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emplenar, copiar, ordenar arrays.\nProva d'amplada de banda de memòria.\nEficiència de memòria cau de CPU."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyplnění, kopírování, řazení polí.\nTest šířky pásma paměti.\nÚčinnost mezipaměti CPU."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyld, kopier, sorter arrays.\nHukommelsesbåndbreddetest.\nCPU-cache-effektivitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrays füllen, kopieren, sortieren.\nSpeicherbandbreitentest.\nCPU-Cache-Effizienz."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γέμισμα, αντιγραφή, ταξινόμηση πινάκων.\nΔοκιμή εύρους ζώνης μνήμης.\nΑποδοτικότητα cache CPU."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llenar, copiar, ordenar arrays.\nPrueba de ancho de banda de memoria.\nEficiencia de caché de CPU."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täytä, kopioi, lajittele taulukot.\nMuistin kaistanleveyden testi.\nCPU-välimuistin tehokkuus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplir, copier, trier des tableaux.\nTest de bande passante mémoire.\nEfficacité du cache CPU."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מילוי, העתקה, מיון מערכים.\nבדיקת רוחב פס זיכרון.\nיעילות מטמון CPU."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrays भरें, कॉपी करें, सॉर्ट करें।\nमेमोरी बैंडविड्थ टेस्ट।\nCPU कैश दक्षता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Popunjavanje, kopiranje, sortiranje nizova.\nTest propusnosti memorije.\nUčinkovitost CPU predmemorije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tömbök kitöltése, másolása, rendezése.\nMemória sávszélesség teszt.\nCPU gyorsítótár hatékonyság."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isi, salin, urutkan array.\nTes bandwidth memori.\nEfisiensi cache CPU."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riempire, copiare, ordinare array.\nTest di larghezza di banda memoria.\nEfficienza cache CPU."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配列の塗りつぶし、コピー、ソート。\nメモリ帯域幅テスト。\nCPUキャッシュ効率。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배열 채우기, 복사, 정렬 성능입니다.\n메모리 대역폭을 테스트합니다.\nCPU 캐시 효율성을 측정합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
