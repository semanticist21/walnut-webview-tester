        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayfa viewport meta ile devre dışı bıraksa bile yakınlaştırmaya izin verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволяє pinch-to-zoom навіть коли сторінка вимикає його через meta viewport."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép zoom bằng kẹp ngay cả khi trang vô hiệu hóa qua thẻ meta viewport."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使页面通过 viewport meta 标签禁用缩放，也允许捏合缩放。"
