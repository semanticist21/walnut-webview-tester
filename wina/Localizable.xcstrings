    "Play videos in page.\nOff = Always fullscreen.\nNeeded for background videos." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشغيل الفيديو في الصفحة.\nإيقاف = دائماً ملء الشاشة.\nمطلوب لفيديوهات الخلفية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprodueix vídeos a la pàgina.\nDesactivat = Sempre pantalla completa.\nNecessari per a vídeos de fons."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přehrávat videa na stránce.\nVypnuto = Vždy na celou obrazovku.\nPotřeba pro videa na pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspil videoer på siden.\nSlået fra = Altid fuld skærm.\nNødvendig for baggrundsvideo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videos in Seite abspielen.\nAus = Immer Vollbild.\nFür Hintergrundvideos erforderlich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναπαραγωγή βίντεο στη σελίδα.\nΑπενεργοποίηση = Πάντα πλήρης οθόνη.\nΑπαραίτητο για βίντεο φόντου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproducir videos en la página.\nOff = Siempre pantalla completa.\nNecesario para videos de fondo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toista videoita sivulla.\nPois = Aina koko näyttö.\nTarvitaan taustvideoille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lire vidéos dans la page.\nOff = Toujours plein écran.\nNécessaire pour vidéos de fond."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפעל סרטונים בעמוד.\nכבוי = תמיד מסך מלא.\nנדרש לסרטוני רקע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पेज में वीडियो चलाएं।\nबंद = हमेशा फुलस्क्रीन।\nबैकग्राउंड वीडियो के लिए आवश्यक।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduciraj video na stranici.\nIsključeno = Uvijek preko cijelog zaslona.\nPotrebno za pozadinske videozapise."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videók lejátszása oldalon.\nKi = Mindig teljes képernyő.\nSzükséges háttérvideókhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar video di halaman.\nMatikan = Selalu layar penuh.\nDiperlukan untuk video latar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduci video nella pagina.\nOff = Sempre schermo intero.\nNecessario per video di sfondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページ内で動画を再生します。\nオフ = 常にフルスクリーン。\n背景動画に必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페이지 안에서 비디오를 재생합니다.\n배경 비디오에 필요합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Main video dalam halaman.\nMati = Sentiasa skrin penuh.\nDiperlukan untuk video latar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spill videoer på siden.\nAv = Alltid fullskjerm.\nTrengs for bakgrunnsvideoer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video's in pagina afspelen.\nUit = Altijd volledig scherm.\nNodig voor achtergrondvideo's."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarzaj filmy na stronie.\nWył. = Zawsze pełny ekran.\nPotrzebne dla filmów w tle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduzir vídeos na página.\nOff = Sempre tela cheia.\nNecessário para vídeos de fundo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduzir vídeos na página.\nOff = Sempre ecrã inteiro.\nNecessário para vídeos de fundo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redă videoclipuri în pagină.\nOprit = Mereu ecran complet.\nNecesar pentru videoclipuri de fundal."
