          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Densidade de pixels físicos.\nPode diferir da escala da tela\nem alguns dispositivos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Densidade de pixels físicos.\nPode diferir da escala do ecrã\nem alguns dispositivos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Densitate fizică a pixelilor.\nPoate diferi de Scala ecranului\npe unele dispozitive."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Физическая плотность пикселей.\nМожет отличаться от масштаба экрана\nна некоторых устройствах."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyzická hustota pixelov.\nMôže sa líšiť od mierky obrazovky\nna niektorých zariadeniach."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fysisk pixeltäthet.\nKan skilja sig från skärmskala\npå vissa enheter."
