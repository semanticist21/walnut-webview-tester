          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволяє window.open() без дії користувача. Вимкніть для блокування спливаючих вікон."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
