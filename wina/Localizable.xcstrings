    "Allows elements to enter fullscreen mode. Full API available on iPad only; iPhone is limited to video elements." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسمح بوضع ملء الشاشة. API كامل على iPad فقط؛ iPhone محدود بالفيديو."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet el mode de pantalla completa. API complet només a iPad; iPhone limitat a vídeos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoluje režim celé obrazovky. Plné API pouze na iPadu; iPhone omezen na video."
          }
        },
        "da" : {
          "stringUnit" : {
