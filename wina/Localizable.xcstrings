          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许无用户手势的window.open()。禁用以阻止弹出窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許無使用者手勢的window.open()。停用以阻擋彈出視窗。"
          }
        }
      }
