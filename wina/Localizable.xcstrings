    "Tab-scoped storage.\nCleared when tab closes.\nSame origin policy applies." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تخزين نطاق علامة التبويب.\nيُمسح عند إغلاق علامة التبويب.\nسياسة المصدر الواحد سارية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emmagatzematge d'abast de pestanya.\nEsborrat en tancar la pestanya.\nS'aplica la política del mateix origen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úložiště karty.\nVymazáno při zavření karty.\nPlatí politika stejného původu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fane-afgrænset lager.\nSlettes når fane lukkes.\nSame-origin politik gælder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab-bezogener Speicher.\nWird beim Schließen des Tabs gelöscht.\nSame-Origin-Policy gilt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθήκευση εμβέλειας καρτέλας.\nΔιαγράφεται όταν κλείνει η καρτέλα.\nΙσχύει πολιτική same-origin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almacenamiento de pestaña.\nSe borra al cerrar la pestaña.\nAplica política de mismo origen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välilehden laajuinen tallennustila.\nTyhjennetään välilehden sulkeutuessa.\nSame-origin-käytäntö pätee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stockage limité à l'onglet.\nEffacé à la fermeture de l'onglet.\nPolitique de même origine."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אחסון בהיקף כרטיסייה.\nנמחק בסגירת כרטיסייה.\nמדיניות same-origin חלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टैब-स्कोप्ड स्टोरेज।\nटैब बंद होने पर साफ़ हो जाता है।\nसमान मूल नीति लागू होती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohrana opsega kartice.\nBriše se pri zatvaranju kartice.\nPrimjenjuje se pravilo istog podrijetla."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lap hatókörű tárolás.\nTörlődik a lap bezárásakor.\nSame-origin szabály érvényes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyimpanan lingkup tab.\nDihapus saat tab ditutup.\nKebijakan asal yang sama berlaku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiviazione per scheda.\nCancellata alla chiusura della scheda.\nPolitica same-origin applicata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブ範囲のストレージです。\nタブを閉じるとクリアされます。\n同一オリジンポリシーが適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 범위 저장소입니다.\n탭을 닫으면 삭제됩니다.\n동일 출처 정책이 적용됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storan skop tab.\nDipadam apabila tab ditutup.\nDasar asal sama terpakai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanebasert lagring.\nSlettes når fane lukkes.\nSame-origin policy gjelder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab-bereik opslag.\nGewist bij sluiten tab.\nSame-origin beleid van toepassing."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamięć karty.\nCzyszczona przy zamknięciu karty.\nObowiązuje polityka same-origin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armazenamento de aba.\nLimpo ao fechar a aba.\nPolítica de mesma origem aplica."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armazenamento de separador.\nLimpo ao fechar o separador.\nPolítica de mesma origem aplica."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stocare la nivel de filă.\nȘtearsă la închiderea filei.\nPolitica same-origin se aplică."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранилище вкладки.\nОчищается при закрытии вкладки.\nПрименяется политика same-origin."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úložisko karty.\nVymazané pri zatvorení karty.\nPlatí politika rovnakého pôvodu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flikbaserad lagring.\nRensas när flik stängs.\nSame-origin policy gäller."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่เก็บข้อมูลในขอบเขตแท็บ\nล้างเมื่อปิดแท็บ\nนโยบาย Same origin ใช้งานได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekme kapsamlı depolama.\nSekme kapandığında temizlenir.\nAynı kaynak politikası uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сховище вкладки.\nОчищається при закритті вкладки.\nПолітика same-origin застосовується."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ nhớ phạm vi tab.\nXóa khi đóng tab.\nChính sách cùng nguồn được áp dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签页范围的存储。\n关闭标签页时清除。\n适用同源策略。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分頁範圍的儲存。\n關閉分頁時清除。\n適用同源政策。"
          }
        }
      }
    },
