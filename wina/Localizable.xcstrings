    "Native iOS share sheet.\nOnly in Safari browser.\nShare links, text, files." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ورقة مشاركة iOS الأصلية.\nفقط في Safari.\nمشاركة الروابط والنصوص والملفات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full de compartir natiu d'iOS.\nNomés a Safari.\nComparteix enllaços, text, fitxers."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nativní sdílecí list iOS.\nPouze v Safari.\nSdílet odkazy, text, soubory."
