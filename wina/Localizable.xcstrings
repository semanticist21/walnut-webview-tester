    "Read/write NFC tags.\niOS: Not supported in browsers.\nUse native apps instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قراءة/كتابة علامات NFC.\niOS: غير مدعوم في المتصفحات.\nاستخدم التطبيقات الأصلية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llegir/escriure etiquetes NFC.\niOS: No compatible en navegadors.\nUtilitzeu aplicacions natives."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čtení/zápis NFC tagů.\niOS: Nepodporováno v prohlížečích.\nPoužijte nativní aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læs/skriv NFC-tags.\niOS: Ikke understøttet i browsere.\nBrug native apps."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NFC-Tags lesen/schreiben.\niOS: Nicht in Browsern unterstützt.\nVerwenden Sie native Apps."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανάγνωση/εγγραφή ετικετών NFC.\niOS: Δεν υποστηρίζεται σε προγράμματα περιήγησης.\nΧρησιμοποιήστε εγγενείς εφαρμογές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer/escribir etiquetas NFC.\niOS: No compatible en navegadores.\nUse aplicaciones nativas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
