        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τρέχοντες ενεργοί πυρήνες.\nΜπορεί να αλλάξει ανάλογα με τη θερμοκρασία ή τη λειτουργία εξοικονόμησης ενέργειας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
