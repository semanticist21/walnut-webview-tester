    "iPad: Full support.\nAny element can go fullscreen.\nVideos, games, presentations." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: دعم كامل.\nأي عنصر يمكن أن يصبح ملء الشاشة.\nالفيديوهات والألعاب والعروض التقديمية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Suport complet.\nQualsevol element pot anar a pantalla completa.\nVídeos, jocs, presentacions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Plná podpora.\nJakýkoli prvek může přejít na celou obrazovku.\nVidea, hry, prezentace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Fuld support.\nEthvert element kan blive fuldskærm.\nVideoer, spil, præsentationer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Vollständig unterstützt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Πλήρης υποστήριξη.\nΟποιοδήποτε στοιχείο μπορεί να γίνει πλήρης οθόνη.\nΒίντεο, παιχνίδια, παρουσιάσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Soporte completo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Täysi tuki.\nMikä tahansa elementti voi mennä koko näytölle.\nVideot, pelit, esitykset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad : Prise en charge complète."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: תמיכה מלאה.\nכל אלמנט יכול להיות במסך מלא.\nסרטונים, משחקים, מצגות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: पूर्ण समर्थन।\nकोई भी तत्व पूर्ण स्क्रीन हो सकता है।\nवीडियो, गेम, प्रस्तुतियां।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Puna podrška.\nBilo koji element može ići na cijeli zaslon.\nVideozapisi, igre, prezentacije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Teljes támogatás.\nBármely elem teljes képernyős lehet.\nVideók, játékok, prezentációk."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Dukungan penuh.\nElemen apa pun bisa layar penuh.\nVideo, game, presentasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Supporto completo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: 完全サポート。\nどの要素でもフルスクリーンにできます。\nビデオ、ゲーム、プレゼンテーションに。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad에서 완전 지원합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Sokongan penuh.\nMana-mana elemen boleh skrin penuh.\nVideo, permainan, pembentangan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Full støtte.\nEthvert element kan bli fullskjerm.\nVideoer, spill, presentasjoner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Volledige ondersteuning.\nElk element kan volledig scherm worden.\nVideo's, games, presentaties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Pełna obsługa.\nKażdy element może przejść w tryb pełnoekranowy.\nFilmy, gry, prezentacje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Suporte completo.\nQualquer elemento pode ir para tela cheia.\nVídeos, jogos, apresentações."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Suporte completo.\nQualquer elemento pode ir para ecrã inteiro.\nVídeos, jogos, apresentações."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Suport complet.\nOrice element poate trece pe ecran complet.\nVideoclipuri, jocuri, prezentări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Полная поддержка."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Plná podpora.\nAkýkoľvek prvok môže ísť na celú obrazovku.\nVideá, hry, prezentácie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Fullt stöd.\nAlla element kan bli helskärm.\nVideor, spel, presentationer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: รองรับเต็มรูปแบบ\nองค์ประกอบใดก็ได้สามารถเต็มหน้าจอ\nวิดีโอ เกม งานนำเสนอ"
