          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engedélyezi a csíptetős zoomot akkor is, ha az oldal letiltja viewport meta-val."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengizinkan pinch-to-zoom bahkan saat halaman menonaktifkannya via meta viewport."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignora le restrizioni di zoom."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビューポートメタタグでズームが無効になっているページでもピンチズームを許可します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
