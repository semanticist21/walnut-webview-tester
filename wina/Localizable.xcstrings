    "Peer-to-peer communication.\nNeeds camera/mic permissions.\nVideo calls, screen sharing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتصال نظير إلى نظير.\nيتطلب أذونات الكاميرا/الميكروفون.\nمكالمات فيديو، مشاركة شاشة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunicació punt a punt.\nNecessita permisos de càmera/micròfon.\nVideotrucades, compartir pantalla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peer-to-peer komunikace.\nVyžaduje oprávnění kamery/mikrofonu.\nVideohovory, sdílení obrazovky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peer-to-peer kommunikation.\nKræver kamera-/mikrofonrettigheder.\nVideoopkald, skærmdeling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peer-to-Peer-Kommunikation.\nBenötigt Kamera-/Mikrofon-Berechtigungen.\nVideoanrufe, Bildschirmfreigabe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επικοινωνία peer-to-peer.\nΑπαιτούνται δικαιώματα κάμερας/μικροφώνου.\nΒιντεοκλήσεις, κοινή χρήση οθόνης."
          }
        },
        "es" : {
          "stringUnit" : {
