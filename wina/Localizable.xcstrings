    "Floating video window.\nWatch while using other apps.\nSwipe up or tap button." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نافذة فيديو عائمة.\nشاهد أثناء استخدام تطبيقات أخرى.\nاسحب لأعلى أو اضغط على الزر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finestra de vídeo flotant.\nMira mentre fas servir altres apps.\nLlisca cap amunt o toca el botó."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plovoucí okno videa.\nSledujte při používání jiných aplikací.\nPřejeďte nahoru nebo klepněte na tlačítko."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flydende videovindue.\nSe mens du bruger andre apps.\nStryg op eller tryk på knap."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwebendes Videofenster.\nSchauen während anderer Apps.\nNach oben wischen oder Button tippen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αιωρούμενο παράθυρο βίντεο.\nΠαρακολουθήστε χρησιμοποιώντας άλλες εφαρμογές.\nΣύρετε επάνω ή πατήστε κουμπί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventana de video flotante.\nVer mientras usas otras apps.\nDesliza hacia arriba o toca el botón."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelluva videoikkuna.\nKatso käyttäessäsi muita sovelluksia.\nPyyhkäise ylös tai napauta painiketta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fenêtre vidéo flottante.\nRegarder en utilisant d'autres apps.\nBalayer vers le haut ou appuyer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חלון וידאו צף.\nצפה בזמן שימוש באפליקציות אחרות.\nהחלק למעלה או הקש על הכפתור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ्लोटिंग वीडियो विंडो।\nअन्य ऐप्स का उपयोग करते समय देखें।\nऊपर स्वाइप करें या बटन टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plutajući video prozor.\nGledajte dok koristite druge aplikacije.\nPomaknite prema gore ili dodirnite gumb."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebegő videóablak.\nNézze más alkalmazások használata közben.\nHúzzon felfelé vagy érintse meg a gombot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jendela video mengambang.\nTonton sambil menggunakan app lain.\nGeser ke atas atau ketuk tombol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finestra video flottante.\nGuarda usando altre app.\nScorri su o tocca il pulsante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フローティングビデオウィンドウです。\n他のアプリを使いながら視聴可能。\n上にスワイプまたはボタンをタップ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플로팅 비디오 창입니다.\n다른 앱 사용 중에도 시청 가능합니다.\n위로 스와이프하거나 버튼을 탭합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetingkap video terapung.\nTonton semasa menggunakan aplikasi lain.\nLeret ke atas atau ketik butang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytende videovindu.\nSe mens du bruker andre apper.\nSveip opp eller trykk på knappen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwevend videovenster.\nKijken terwijl je andere apps gebruikt.\nVeeg omhoog of tik op knop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pływające okno wideo.\nOglądaj korzystając z innych aplikacji.\nPrzesuń w górę lub dotknij przycisku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janela de vídeo flutuante.\nAssistir enquanto usa outros apps.\nDeslize para cima ou toque no botão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janela de vídeo flutuante.\nVer enquanto usa outras apps.\nDeslize para cima ou toque no botão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fereastră video plutitoare.\nUrmărește în timp ce folosești alte aplicații.\nGlisează în sus sau atinge butonul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плавающее окно видео.\nСмотрите, используя другие приложения.\nСвайп вверх или нажмите кнопку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plávajúce okno videa.\nSledujte pri používaní iných aplikácií.\nPrejdite nahor alebo klepnite na tlačidlo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytande videofönster.\nTitta medan du använder andra appar.\nSvep upp eller tryck på knappen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หน้าต่างวิดีโอลอย\nดูขณะใช้แอปอื่น\nปัดขึ้นหรือแตะปุ่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüzen video penceresi.\nDiğer uygulamaları kullanırken izle.\nYukarı kaydır veya düğmeye dokun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плаваюче вікно відео.\nДивіться, використовуючи інші додатки.\nСвайп вгору або натисніть кнопку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cửa sổ video nổi.\nXem khi dùng ứng dụng khác.\nVuốt lên hoặc nhấn nút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浮动视频窗口。\n使用其他应用时观看。\n向上滑动或点击按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浮動影片視窗。\n使用其他應用程式時觀看。\n向上滑動或點擊按鈕。"
          }
        }
      }
    },
