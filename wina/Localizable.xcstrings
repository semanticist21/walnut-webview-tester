          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cœurs actuellement actifs.\nPeut varier selon l'état thermique ou le mode économie d'énergie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ליבות פעילות כרגע.\nעשוי להשתנות בהתאם לטמפרטורה או מצב חיסכון בחשמל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्तमान में सक्रिय कोर।\nतापमान या कम पावर मोड के आधार पर बदल सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
