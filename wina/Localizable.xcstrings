    "Enable/disable all JavaScript.\nOff = No scripts run at all.\nMost websites won't work." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمكين/تعطيل JavaScript.\nإيقاف = لا تعمل أي نصوص.\nمعظم المواقع لن تعمل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa/desactiva JavaScript.\nDesactivat = No s'executen scripts.\nLa majoria de webs no funcionaran."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnout/vypnout JavaScript.\nVyp. = Žádné skripty se nespouštějí.\nVětšina webů nebude fungovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver/deaktiver JavaScript.\nFra = Ingen scripts kører.\nDe fleste websites virker ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JavaScript aktivieren/deaktivieren.\nAus = Keine Skripte werden ausgeführt.\nDie meisten Websites funktionieren nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποίηση/απενεργοποίηση JavaScript.\nΚλειστό = Κανένα σενάριο δεν εκτελείται.\nΟι περισσότεροι ιστότοποι δεν θα λειτουργούν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activar/desactivar JavaScript.\nDesactivado = No se ejecutan scripts.\nLa mayoría de sitios no funcionarán."
