    "Swipe to go back/forward.\nOff = Use buttons only.\nAvoids conflicts with page gestures." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب للعودة/التقدم.\nإيقاف = استخدم الأزرار فقط.\nيتجنب التعارض مع إيماءات الصفحة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llisca per anar enrere/endavant.\nDesactivat = Usa només botons.\nEvita conflictes amb gestos de la pàgina."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejetím přejít zpět/vpřed.\nVyp = Používat pouze tlačítka.\nVyhýbá se konfliktům s gesty stránky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stryg for at gå tilbage/frem.\nFra = Brug kun knapper.\nUndgår konflikter med sidebevægelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wischen zum Zurück-/Vorwärtsgehen.\nAus = Nur Tasten verwenden.\nVermeidet Konflikte mit Seitengesten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε για πίσω/μπροστά.\nΑνενεργό = Χρήση μόνο κουμπιών.\nΑποφεύγει συγκρούσεις με χειρονομίες σελίδας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslizar para ir atrás/adelante.\nDesactivado = Usar solo botones.\nEvita conflictos con gestos de la página."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyyhkäise mennäksesi taakse/eteen.\nPois = Käytä vain painikkeita.\nVältä ristiriidat sivun eleiden kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisser pour revenir/avancer.\nDésactivé = Utiliser uniquement les boutons.\nÉvite les conflits avec les gestes de la page."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלק כדי לחזור/להתקדם.\nכבוי = השתמש בכפתורים בלבד.\nמונע התנגשויות עם מחוות עמוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वापस/आगे जाने के लिए स्वाइप करें।\nबंद = केवल बटन का उपयोग करें।\nपेज जेस्चर के साथ विरोध से बचाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povucite za natrag/naprijed.\nIsključeno = Koristi samo gumbe.\nIzbjegava sukobe s gestama stranice."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzd a vissza/előre lépéshez.\nKi = Csak gombok.\nElkerüli az oldal gesztusaival való ütközést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser untuk kembali/maju.\nMati = Gunakan tombol saja.\nMenghindari konflik dengan gerakan halaman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri per andare indietro/avanti.\nOff = Usa solo pulsanti.\nEvita conflitti con i gesti della pagina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スワイプで戻る/進むを操作します。\nオフ = ボタンのみ使用。\nページのジェスチャーとの競合を回避します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스와이프로 뒤로/앞으로 이동합니다.\n끄면 버튼만 사용합니다.\n페이지 제스처 충돌을 방지합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leret untuk kembali/maju.\nMati = Gunakan butang sahaja.\nMengelakkan konflik dengan gerak isyarat halaman."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip for å gå tilbake/fremover.\nAv = Bruk kun knapper.\nUnngår konflikter med sidebevegelser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg om terug/vooruit te gaan.\nUit = Alleen knoppen gebruiken.\nVoorkomt conflicten met paginagebaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń, aby przejść wstecz/dalej.\nWył = Używaj tylko przycisków.\nUnika konfliktów z gestami strony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para voltar/avançar.\nDesligado = Usar apenas botões.\nEvita conflitos com gestos da página."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para recuar/avançar.\nDesligado = Usar apenas botões.\nEvita conflitos com gestos da página."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisați pentru înapoi/înainte.\nOprit = Folosiți doar butoanele.\nEvită conflictele cu gesturile paginii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свайп для перехода назад/вперёд.\nВыкл = Только кнопки.\nИзбегает конфликтов с жестами страницы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potiahnutím prejsť späť/vpred.\nVyp = Používať len tlačidlá.\nVyhýba sa konfliktom s gestami stránky."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep för att gå bakåt/framåt.\nAv = Använd endast knappar.\nUndviker konflikter med sidgester."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปัดเพื่อย้อนกลับ/ไปข้างหน้า\nปิด = ใช้ปุ่มเท่านั้น\nหลีกเลี่ยงความขัดแย้งกับท่าทางหน้าเว็บ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri/ileri gitmek için kaydırın.\nKapalı = Yalnızca düğmeleri kullan.\nSayfa hareketleriyle çakışmayı önler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свайп для переходу назад/вперед.\nВимк = Тільки кнопки.\nУникає конфліктів з жестами сторінки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuốt để quay lại/tiến.\nTắt = Chỉ dùng nút.\nTránh xung đột với cử chỉ trang."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑动返回/前进。\n关闭 = 仅使用按钮。\n避免与页面手势冲突。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑動返回/前進。\n關閉 = 僅使用按鈕。\n避免與頁面手勢衝突。"
          }
        }
      }
    },
