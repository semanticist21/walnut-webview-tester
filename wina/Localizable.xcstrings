    "Full-duplex communication.\nPersistent connection to server.\nGood for real-time apps." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتصال مزدوج كامل.\nاتصال مستمر بالخادم.\nجيد للتطبيقات الفورية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunicació full-duplex.\nConnexió persistent al servidor.\nBo per a apps en temps real."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plně duplexní komunikace.\nTrvalé připojení k serveru.\nDobré pro aplikace v reálném čase."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full-duplex kommunikation.\nVedvarende forbindelse til server.\nGod til realtidsapps."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vollduplex-Kommunikation.\nDauerhafte Verbindung zum Server.\nGut für Echtzeit-Apps."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επικοινωνία πλήρους αμφίδρομης λειτουργίας.\nΜόνιμη σύνδεση με τον διακομιστή.\nΚαλό για εφαρμογές πραγματικού χρόνου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunicación full-duplex.\nConexión persistente al servidor.\nIdeal para apps en tiempo real."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full-duplex-viestintä.\nPysyvä yhteys palvelimeen.\nHyvä reaaliaikaisille sovelluksille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Communication full-duplex.\nConnexion persistante au serveur.\nIdéal pour les apps en temps réel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תקשורת דופלקס מלא.\nחיבור מתמשך לשרת.\nטוב לאפליקציות בזמן אמת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फुल-डुप्लेक्स संचार।\nसर्वर से लगातार कनेक्शन।\nरियल-टाइम ऐप्स के लिए अच्छा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full-duplex komunikacija.\nTrajna veza s poslužiteljem.\nDobro za aplikacije u stvarnom vremenu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full-duplex kommunikáció.\nÁllandó kapcsolat a szerverrel.\nJó valós idejű alkalmazásokhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikasi full-duplex.\nKoneksi persisten ke server.\nBagus untuk aplikasi real-time."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunicazione full-duplex.\nConnessione persistente al server.\nOttimo per app in tempo reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全二重通信。\nサーバーとの持続的接続。\nリアルタイムアプリに最適。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전이중 통신을 지원합니다.\n서버와 지속적으로 연결합니다.\n실시간 앱에 적합합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikasi dupleks penuh.\nSambungan berterusan ke pelayan.\nBaik untuk aplikasi masa nyata."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full-dupleks kommunikasjon.\nVedvarende tilkobling til server.\nBra for sanntidsapper."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full-duplex communicatie.\nPersistente verbinding met server.\nGoed voor realtime apps."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komunikacja full-duplex.\nTrwałe połączenie z serwerem.\nDobre dla aplikacji czasu rzeczywistego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunicação full-duplex.\nConexão persistente com o servidor.\nBom para apps em tempo real."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunicação full-duplex.\nConexão persistente ao servidor.\nBom para apps em tempo real."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunicare full-duplex.\nConexiune persistentă la server.\nBună pentru aplicații în timp real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полнодуплексная связь.\nПостоянное соединение с сервером.\nХорошо для приложений реального времени."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plne duplexná komunikácia.\nTrvalé pripojenie k serveru.\nDobré pre aplikácie v reálnom čase."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full-duplex-kommunikation.\nBeständig anslutning till server.\nBra för realtidsappar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสื่อสารแบบ full-duplex\nการเชื่อมต่อถาวรกับเซิร์ฟเวอร์\nเหมาะสำหรับแอปเรียลไทม์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam çift yönlü iletişim.\nSunucuya kalıcı bağlantı.\nGerçek zamanlı uygulamalar için iyi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повнодуплексний зв'язок.\nПостійне з'єднання з сервером.\nДобре для додатків реального часу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giao tiếp song công đầy đủ.\nKết nối liên tục với máy chủ.\nTốt cho ứng dụng thời gian thực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全双工通信。\n与服务器持久连接。\n适合实时应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全雙工通訊。\n與伺服器持久連線。\n適合即時應用。"
          }
        }
      }
    },
