            "value" : "Vain Safarissa tai kotinäytön verkkosovelluksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement dans Safari ou les apps web sur l'écran d'accueil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק ב-Safari או באפליקציות אינטרנט על מסך הבית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल Safari या होम स्क्रीन वेब ऐप्स में।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo u Safariju ili web aplikacijama na početnom zaslonu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak Safariban vagy kezdőképernyő webalkalmazásokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya di Safari atau aplikasi web layar beranda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo in Safari o nelle web app della schermata Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safariまたはホーム画面ウェブアプリでのみ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari나 홈 화면 웹앱에서만 사용할 수 있습니다."
          }
        },
        "ms" : {
