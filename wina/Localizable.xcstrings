    "iPhone: Not supported.\nOnly videos can go fullscreen.\niPad has full API support." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone: غير مدعوم.\nفقط الفيديوهات يمكنها ملء الشاشة.\niPad يدعم API بالكامل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone: No compatible.\nNomés els vídeos poden anar a pantalla completa.\niPad té suport complet d'API."
