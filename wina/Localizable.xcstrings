          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detecta dates i hores, permetent afegir al Calendari."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detekuje data a časy, umožňuje přidání do Kalendáře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrerer datoer og tidspunkter, tillader tilføjelse til Kalender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkennt Daten und Uhrzeiten, ermöglicht das Hinzufügen zum Kalender."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανιχνεύει ημερομηνίες και ώρες, επιτρέποντας προσθήκη στο Ημερολόγιο."
          }
        },
        "es" : {
