    "Send data on page unload.\nGuaranteed delivery attempt.\nGood for analytics." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إرسال البيانات عند إلغاء تحميل الصفحة.\nمحاولة تسليم مضمونة.\nجيد للتحليلات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia dades en tancar la pàgina.\nIntent de lliurament garantit.\nBo per a analytics."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odeslat data při uvolnění stránky.\nGarantovaný pokus o doručení.\nDobré pro analytiku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send data ved sideafladning.\nGaranteret leveringsforsøg.\nGodt til analytics."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daten bei Seitenentladen senden.\nGarantierter Zustellversuch.\nGut für Analytics."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποστολή δεδομένων κατά την αποφόρτωση.\nΕγγυημένη προσπάθεια παράδοσης.\nΚαλό για analytics."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar datos al descargar página.\nIntento de entrega garantizada.\nBueno para analíticas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähetä tiedot sivun purkautuessa.\nTaattu toimitusyritys.\nHyvä analytiikalle."
          }
