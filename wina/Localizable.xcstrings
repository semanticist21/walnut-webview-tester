    "Detailed timing data (DNS, TCP, TLS, etc.) is unavailable for cross-origin resources unless the server includes a Timing-Allow-Origin header. This is a browser security restriction." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بيانات التوقيت التفصيلية غير متوفرة للموارد عبر المصادر بدون رأس Timing-Allow-Origin. قيد أمان المتصفح."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dades de temps detallades no estan disponibles per a recursos cross-origin sense capçalera Timing-Allow-Origin. Restricció de seguretat del navegador."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrobná data o časování nejsou k dispozici pro cross-origin zdroje bez hlavičky Timing-Allow-Origin. Bezpečnostní omezení prohlížeče."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detaljerede timingdata er ikke tilgængelige for cross-origin ressourcer uden Timing-Allow-Origin header. Browsersikkerhedsbegrænsning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detaillierte Timing-Daten sind für Cross-Origin-Ressourcen ohne Timing-Allow-Origin-Header nicht verfügbar. Browser-Sicherheitsbeschränkung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα λεπτομερή δεδομένα χρονισμού δεν είναι διαθέσιμα για πόρους cross-origin χωρίς κεφαλίδα Timing-Allow-Origin. Περιορισμός ασφαλείας προγράμματος περιήγησης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de tiempo detallados no están disponibles para recursos cross-origin sin cabecera Timing-Allow-Origin. Restricción de seguridad del navegador."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksityiskohtaiset ajoitustiedot eivät ole saatavilla cross-origin-resursseille ilman Timing-Allow-Origin-otsikkoa. Selaimen turvallisuusrajoitus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de timing détaillées ne sont pas disponibles pour les ressources cross-origin sans en-tête Timing-Allow-Origin. Restriction de sécurité du navigateur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נתוני תזמון מפורטים אינם זמינים למשאבי cross-origin ללא כותרת Timing-Allow-Origin. הגבלת אבטחת דפדפן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timing-Allow-Origin हेडर के बिना क्रॉस-ऑरिजिन संसाधनों के लिए विस्तृत टाइमिंग डेटा उपलब्ध नहीं है। ब्राउज़र सुरक्षा प्रतिबंध।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detaljni podaci o vremenu nisu dostupni za cross-origin resurse bez zaglavlja Timing-Allow-Origin. Sigurnosno ograničenje preglednika."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A részletes időzítési adatok nem érhetők el cross-origin erőforrásokhoz Timing-Allow-Origin fejléc nélkül. Böngésző biztonsági korlátozás."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data timing detail tidak tersedia untuk sumber daya cross-origin tanpa header Timing-Allow-Origin. Pembatasan keamanan browser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati di timing dettagliati non sono disponibili per le risorse cross-origin senza intestazione Timing-Allow-Origin. Restrizione di sicurezza del browser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クロスオリジンリソースの詳細タイミングはTiming-Allow-Originヘッダーがないと取得できません。ブラウザのセキュリティ制限です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에 Timing-Allow-Origin 헤더가 없으면 크로스 오리진 리소스의 상세 타이밍을 볼 수 없습니다. 브라우저 보안 제한입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data masa terperinci tidak tersedia untuk sumber cross-origin tanpa pengepala Timing-Allow-Origin. Sekatan keselamatan pelayar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detaljerte tidsdata er ikke tilgjengelige for cross-origin ressurser uten Timing-Allow-Origin header. Nettlesersikkerhetsbegrensning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedetailleerde timinggegevens zijn niet beschikbaar voor cross-origin bronnen zonder Timing-Allow-Origin header. Browserbeveiligingsbeperking."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szczegółowe dane czasowe nie są dostępne dla zasobów cross-origin bez nagłówka Timing-Allow-Origin. Ograniczenie bezpieczeństwa przeglądarki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dados de tempo detalhados não estão disponíveis para recursos cross-origin sem cabeçalho Timing-Allow-Origin. Restrição de segurança do navegador."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dados de tempo detalhados não estão disponíveis para recursos cross-origin sem cabeçalho Timing-Allow-Origin. Restrição de segurança do navegador."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datele detaliate de sincronizare nu sunt disponibile pentru resursele cross-origin fără antetul Timing-Allow-Origin. Restricție de securitate a browserului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подробные данные о времени недоступны для cross-origin ресурсов без заголовка Timing-Allow-Origin. Ограничение безопасности браузера."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrobné údaje o časovaní nie sú k dispozícii pre cross-origin zdroje bez hlavičky Timing-Allow-Origin. Bezpečnostné obmedzenie prehliadača."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detaljerade tidsdata är inte tillgängliga för cross-origin-resurser utan Timing-Allow-Origin-header. Webbläsarsäkerhetsbegränsning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูล timing โดยละเอียดไม่พร้อมใช้งานสำหรับทรัพยากร cross-origin โดยไม่มี header Timing-Allow-Origin ข้อจำกัดด้านความปลอดภัยของเบราว์เซอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrıntılı zamanlama verileri Timing-Allow-Origin başlığı olmadan cross-origin kaynakları için kullanılamaz. Tarayıcı güvenlik kısıtlaması."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Детальні дані про час недоступні для cross-origin ресурсів без заголовка Timing-Allow-Origin. Обмеження безпеки браузера."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu timing chi tiết không khả dụng cho tài nguyên cross-origin nếu không có header Timing-Allow-Origin. Giới hạn bảo mật trình duyệt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非服务器包含Timing-Allow-Origin头，否则无法获取跨域资源的详细计时数据。这是浏览器安全限制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非伺服器包含Timing-Allow-Origin標頭，否則無法取得跨域資源的詳細計時資料。這是瀏覽器安全限制。"
          }
        }
      }
    },
