        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsługa kodeków może się różnić w zależności od urządzenia i wersji systemu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
