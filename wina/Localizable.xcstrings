        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Tam destek.\nHerhangi bir öğe tam ekran olabilir.\nVideolar, oyunlar, sunumlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Повна підтримка.\nБудь-який елемент може стати повноекранним.\nВідео, ігри, презентації."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: Hỗ trợ đầy đủ.\nBất kỳ phần tử nào cũng có thể toàn màn hình.\nVideo, game, thuyết trình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad: 完全支持。\n任何元素都可以全屏。\n适用于视频、游戏、演示。"
          }
