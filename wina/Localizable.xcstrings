        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lecture/écriture de tags NFC.\niOS : Non pris en charge dans les navigateurs.\nUtilisez des applications natives."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קריאה/כתיבה של תגי NFC.\niOS: לא נתמך בדפדפנים.\nהשתמש באפליקציות מקוריות."
