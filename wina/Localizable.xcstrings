          "stringUnit" : {
            "state" : "translated",
            "value" : "ממתין לטעינה מלאה לפני הצגה. עשוי להרגיש איטי יותר אבל נקי יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रदर्शित करने से पहले पूर्ण पृष्ठ लोड की प्रतीक्षा करता है। धीमा लग सकता है लेकिन साफ़।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čeka potpuno učitavanje stranice prije prikaza. Može djelovati sporije ali čišće."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megvárja a teljes oldalbetöltést megjelenítés előtt. Lassabbnak tűnhet, de tisztább."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunggu pemuatan halaman penuh sebelum menampilkan. Mungkin terasa lebih lambat tapi lebih rapi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attende il caricamento completo prima della visualizzazione. Può sembrare più lento ma più pulito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示前にページ全体の読み込みを待ちます。遅く感じる場合がありますが、よりきれいに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "표시 전에 전체 페이지 로드를 대기합니다. 느리게 느껴질 수 있지만 깔끔합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunggu muatan halaman penuh sebelum memaparkan. Mungkin terasa lebih perlahan tetapi lebih kemas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på full sidelasting før visning. Kan føles tregere men renere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wacht op volledig laden voor weergave. Kan langzamer aanvoelen maar schoner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czeka na pełne załadowanie przed wyświetleniem. Może działać wolniej, ale czystszy wygląd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguarda carregamento completo antes de exibir. Pode parecer mais lento, mas mais limpo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguarda carregamento completo antes de exibir. Pode parecer mais lento, mas mais limpo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Așteaptă încărcarea completă a paginii înainte de afișare. Poate părea mai lent dar mai curat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ждёт полной загрузки страницы перед отображением. Может казаться медленнее, но чище."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čaká na úplné načítanie stránky pred zobrazením. Môže pôsobiť pomalšie, ale čistejšie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väntar på full sidladdning innan visning. Kan kännas långsammare men renare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รอโหลดหน้าเต็มก่อนแสดง อาจรู้สึกช้าแต่สะอาดกว่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüntülemeden önce tam sayfa yüklemesini bekler. Daha yavaş hissedebilir ama daha temiz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очікує повного завантаження сторінки перед відображенням. Може здаватися повільнішим, але охайнішим."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đợi tải trang đầy đủ trước khi hiển thị. Có thể cảm thấy chậm hơn nhưng gọn gàng hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示前等待完整页面加载。可能感觉较慢但更整洁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示前等待完整頁面載入。可能感覺較慢但更整潔。"
          }
        }
      }
    },
    "Warn about dangerous sites.\nPhishing and malware alerts.\nKeep on for safety." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحذير من المواقع الخطرة.\nتنبيهات التصيد والبرامج الضارة.\nأبق مفعلاً للسلامة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa sobre llocs perillosos.\nAlertes de phishing i malware.\nMantén activat per seguretat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varovat před nebezpečnými stránkami.\nUpozornění na phishing a malware.\nNechte zapnuté pro bezpečnost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advar om farlige sider.\nPhishing- og malware-advarsler.\nHold aktiveret for sikkerhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor gefährlichen Seiten warnen.\nPhishing- und Malware-Warnungen.\nZur Sicherheit aktiviert lassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προειδοποίηση για επικίνδυνες ιστοσελίδες.\nΕιδοποιήσεις phishing και malware.\nΚρατήστε ενεργό για ασφάλεια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advertir sobre sitios peligrosos.\nAlertas de phishing y malware.\nMantener activado por seguridad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varoita vaarallisista sivustoista.\nTietojenkalastelu- ja haittaohjelmahälytykset.\nPidä päällä turvallisuuden vuoksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avertir des sites dangereux.\nAlertes phishing et malware.\nGarder activé pour la sécurité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזהר מאתרים מסוכנים.\nהתראות פישינג ותוכנות זדוניות.\nהשאר מופעל לבטיחות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खतरनाक साइटों के बारे में चेतावनी दें।\nफ़िशिंग और मैलवेयर अलर्ट।\nसुरक्षा के लिए चालू रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozori na opasne stranice.\nUpozorenja za phishing i zlonamjerni softver.\nOstavite uključeno za sigurnost."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Figyelmeztetés veszélyes oldalakról.\nAdathalászat és kártevő figyelmeztetések.\nTartsa bekapcsolva a biztonság érdekében."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peringatkan tentang situs berbahaya.\nPeringatan phishing dan malware.\nBiarkan aktif untuk keamanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvisa di siti pericolosi.\nAvvisi phishing e malware.\nTenere attivo per sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "危険なサイトについて警告します。\nフィッシングとマルウェアのアラート。\n安全のためオンにしておいてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위험한 사이트를 경고합니다.\n안전을 위해 켜두십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amaran tentang laman berbahaya.\nAmaran phishing dan malware.\nKekalkan aktif untuk keselamatan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advar om farlige nettsteder.\nPhishing- og malware-varsler.\nHold på for sikkerhet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarschuw voor gevaarlijke sites.\nPhishing- en malwarewaarschuwingen.\nAan laten voor veiligheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostrzegaj o niebezpiecznych stronach.\nAlerty o phishingu i malware.\nPozostaw włączone dla bezpieczeństwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisar sobre sites perigosos.\nAlertas de phishing e malware.\nMantenha ligado para segurança."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisar sobre sites perigosos.\nAlertas de phishing e malware.\nMantenha ligado para segurança."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avertizează despre site-uri periculoase.\nAlerte phishing și malware.\nPăstrați activat pentru siguranță."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предупреждать об опасных сайтах.\nОповещения о фишинге и вредоносном ПО.\nОставьте включённым для безопасности."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varovať pred nebezpečnými stránkami.\nUpozornenia na phishing a malvér.\nNechajte zapnuté pre bezpečnosť."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varna för farliga webbplatser.\nPhishing- och malwarevarningar.\nHåll på för säkerhet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เตือนเกี่ยวกับไซต์อันตราย\nการแจ้งเตือน phishing และ malware\nเปิดไว้เพื่อความปลอดภัย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tehlikeli siteler hakkında uyar.\nOltalama ve kötü amaçlı yazılım uyarıları.\nGüvenlik için açık tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попереджати про небезпечні сайти.\nСповіщення про фішинг і шкідливе ПЗ.\nЗалиште увімкненим для безпеки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảnh báo về các trang nguy hiểm.\nCảnh báo phishing và malware.\nGiữ bật để an toàn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告危险网站。\n钓鱼和恶意软件警报。\n为安全起见保持开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告危險網站。\n釣魚和惡意軟體警報。\n為安全起見保持開啟。"
          }
        }
      }
    },
