    "Video plays in floating window.\nWorks on video elements.\nUser must initiate." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فيديو في نافذة عائمة.\nيعمل على عناصر الفيديو.\nيجب أن يبدأ المستخدم."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vídeo es reprodueix en finestra flotant.\nFunciona en elements de vídeo.\nL'usuari ha d'iniciar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video se přehrává v plovoucím okně.\nFunguje na video prvcích.\nUživatel musí zahájit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video afspilles i flydende vindue.\nVirker på video-elementer.\nBruger skal starte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video in schwebendem Fenster.\nFunktioniert bei Video-Elementen.\nBenutzer muss starten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βίντεο αναπαράγεται σε αιωρούμενο παράθυρο.\nΛειτουργεί σε στοιχεία βίντεο.\nΟ χρήστης πρέπει να ξεκινήσει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video en ventana flotante.\nFunciona en elementos de video.\nEl usuario debe iniciar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video toistuu kelluvassa ikkunassa.\nToimii video-elementeillä.\nKäyttäjän on aloitettava."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidéo dans fenêtre flottante.\nFonctionne sur éléments vidéo.\nL'utilisateur doit initier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "וידאו מנגן בחלון צף.\nעובד על אלמנטי וידאו.\nהמשתמש צריך להתחיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वीडियो फ्लोटिंग विंडो में चलता है।\nवीडियो एलिमेंट्स पर काम करता है।\nउपयोगकर्ता को शुरू करना होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video se reproducira u plutajućem prozoru.\nRadi na video elementima.\nKorisnik mora pokrenuti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videó lebegő ablakban játszik.\nVideó elemeken működik.\nFelhasználónak kell indítania."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video diputar di jendela mengambang.\nBekerja pada elemen video.\nPengguna harus memulai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video in finestra flottante.\nFunziona su elementi video.\nL'utente deve avviare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フローティングウィンドウで動画を再生します。\nビデオ要素で動作します。\nユーザーが開始する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플로팅 창에서 비디오를 재생합니다.\n비디오 요소에서 작동합니다.\n사용자가 시작해야 합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video dimainkan dalam tetingkap terapung.\nBerfungsi pada elemen video.\nPengguna mesti memulakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video spilles i flytende vindu.\nFungerer på video-elementer.\nBruker må starte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video in zwevend venster.\nWerkt op video-elementen.\nGebruiker moet starten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wideo w pływającym oknie.\nDziała na elementach wideo.\nUżytkownik musi zainicjować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeo em janela flutuante.\nFunciona em elementos de vídeo.\nUsuário deve iniciar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeo em janela flutuante.\nFunciona em elementos de vídeo.\nUtilizador deve iniciar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video se redă în fereastră plutitoare.\nFuncționează pe elemente video.\nUtilizatorul trebuie să inițieze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видео в плавающем окне.\nРаботает на видео элементах.\nПользователь должен инициировать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video sa prehráva v plávajúcom okne.\nFunguje na video prvkoch.\nPoužívateľ musí spustiť."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video spelas i flytande fönster.\nFungerar på videoelement.\nAnvändaren måste starta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วิดีโอเล่นในหน้าต่างลอย\nทำงานบนองค์ประกอบวิดีโอ\nผู้ใช้ต้องเริ่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video yüzen pencerede oynar.\nVideo öğelerinde çalışır.\nKullanıcı başlatmalı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відео в плаваючому вікні.\nПрацює на відео елементах.\nКористувач повинен ініціювати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video phát trong cửa sổ nổi.\nHoạt động trên phần tử video.\nNgười dùng phải khởi động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在浮动窗口中播放视频。\n适用于视频元素。\n用户必须启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在浮動視窗中播放影片。\n適用於影片元素。\n使用者必須啟動。"
          }
        }
      }
    },
