    "Darwin kernel build number.\nUseful for tracking WebKit bugs\nin specific OS builds." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رقم بناء نواة Darwin.\nمفيد لتتبع أخطاء WebKit\nفي بنيات نظام تشغيل محددة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de compilació del nucli Darwin.\nÚtil per fer seguiment d'errors de WebKit\nen compilacions específiques del SO."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Číslo sestavení jádra Darwin.\nUžitečné pro sledování chyb WebKit\nv konkrétních sestaveních OS."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darwin kernel build-nummer.\nNyttigt til sporing af WebKit-bugs\ni specifikke OS-builds."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darwin-Kernel Build-Nummer.\nNützlich für das Tracking von WebKit-Bugs\nin bestimmten OS-Builds."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αριθμός έκδοσης πυρήνα Darwin.\nΧρήσιμο για την παρακολούθηση σφαλμάτων WebKit\nσε συγκεκριμένες εκδόσεις λειτουργικού συστήματος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de compilación del kernel Darwin.\nÚtil para rastrear errores de WebKit\nen compilaciones específicas del SO."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darwin-ytimen koontiversio.\nHyödyllinen WebKit-virheiden seuraamiseen\ntietyissä käyttöjärjestelmäkoonneissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numéro de build du noyau Darwin.\nUtile pour suivre les bugs WebKit\ndans des builds OS spécifiques."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מספר בנייה של ליבת Darwin.\nשימושי למעקב אחר באגים של WebKit\nבבניות מערכת הפעלה ספציפיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darwin कर्नेल बिल्ड नंबर।\nविशिष्ट OS बिल्ड में\nWebKit बग ट्रैक करने के लिए उपयोगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broj izgradnje Darwin kernela.\nKoristan za praćenje WebKit grešaka\nu određenim izgradnjama OS-a."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darwin kernel build szám.\nHasznos WebKit hibák követéséhez\nadott OS buildekben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomor build kernel Darwin.\nBerguna untuk melacak bug WebKit\ndi build OS tertentu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numero di build del kernel Darwin.\nUtile per tracciare bug di WebKit\nin build specifici del SO."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
