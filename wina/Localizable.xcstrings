    "Physical pixel density.\nMay differ from Screen Scale\non some devices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كثافة البكسل الفعلية.\nقد تختلف عن مقياس الشاشة\nفي بعض الأجهزة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Densitat de píxels física.\nPot diferir de l'escala de pantalla\nen alguns dispositius."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyzická hustota pixelů.\nMůže se lišit od měřítka obrazovky\nna některých zařízeních."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fysisk pixeltæthed.\nKan afvige fra skærmskala\npå nogle enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Physische Pixeldichte.\nKann sich von der Bildschirmskalierung\nauf einigen Geräten unterscheiden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φυσική πυκνότητα pixels.\nΜπορεί να διαφέρει από την κλίμακα οθόνης\nσε ορισμένες συσκευές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Densidad de píxeles física.\nPuede diferir de la escala de pantalla\nen algunos dispositivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyysinen pikselitiheys.\nVoi erota näytön mittakaavasta\njoillakin laitteilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Densité de pixels physique.\nPeut différer de l'échelle d'écran\nsur certains appareils."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צפיפות פיקסלים פיזית.\nעשויה להיות שונה מקנה המידה של המסך\nבחלק מהמכשירים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भौतिक पिक्सेल घनत्व।\nकुछ उपकरणों पर स्क्रीन स्केल\nसे भिन्न हो सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fizička gustoća piksela.\nMože se razlikovati od razmjera zaslona\nna nekim uređajima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fizikai pixelsűrűség.\nEltérhet a képernyőméretaránytól\negyeseszközökön."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kepadatan piksel fisik.\nMungkin berbeda dari Skala Layar\ndi beberapa perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Densità fisica dei pixel.\nPuò differire dalla scala schermo\nsu alcuni dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "物理ピクセル密度。\n一部のデバイスでは画面スケールと異なる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "물리적 픽셀 밀도입니다.\n화면 배율과 다를 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketumpatan piksel fizikal.\nMungkin berbeza daripada Skala Skrin\npada sesetengah peranti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fysisk pikseltetthet.\nKan avvike fra skjermskalering\npå noen enheter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
