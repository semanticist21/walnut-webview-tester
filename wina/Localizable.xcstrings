        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čitanje/pisanje NFC oznaka.\niOS: Nije podržano u preglednicima.\nKoristite izvorne aplikacije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
