    "Cookies are NOT shared with Safari app. Each app has separate cookie storage." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملفات تعريف الارتباط غير مشتركة مع Safari. كل تطبيق لديه تخزين منفصل للكوكيز."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cookies NO es comparteixen amb Safari. Cada app té emmagatzematge de cookies separat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookies NEJSOU sdíleny se Safari. Každá aplikace má oddělené úložiště cookies."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookies deles IKKE med Safari. Hver app har separat cookie-lager."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookies werden NICHT mit Safari geteilt. Jede App hat separaten Cookie-Speicher."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα cookies ΔΕΝ μοιράζονται με το Safari. Κάθε εφαρμογή έχει ξεχωριστή αποθήκευση cookies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cookies NO se comparten con Safari. Cada app tiene almacenamiento de cookies separado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evästeitä EI jaeta Safarin kanssa. Jokaisella sovelluksella on erillinen evästetallennustila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cookies NE sont PAS partagés avec Safari. Chaque app a son propre stockage cookies."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עוגיות לא משותפות עם Safari. לכל אפליקציה אחסון עוגיות נפרד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुकीज़ Safari ऐप के साथ साझा नहीं होती हैं। प्रत्येक ऐप का अलग कुकी स्टोरेज है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolačići se NE dijele sa Safarijem. Svaka aplikacija ima zasebnu pohranu kolačića."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cookie-k NEM osztódnak meg a Safarival. Minden alkalmazásnak külön cookie tárolója van."
          }
        },
        "id" : {
