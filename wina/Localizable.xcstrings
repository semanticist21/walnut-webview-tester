    "Push notifications from websites.\nOnly in Safari or home screen apps.\niOS 16.4+ required." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إشعارات فورية من المواقع.\nفقط في Safari أو تطبيقات الشاشة الرئيسية.\nيتطلب iOS 16.4+."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificacions push de llocs web.\nNomés a Safari o apps de pantalla d'inici.\nRequereix iOS 16.4+."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push oznámení z webových stránek.\nPouze v Safari nebo aplikacích na ploše.\nVyžaduje iOS 16.4+."
