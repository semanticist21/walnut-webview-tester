    "Preview links before opening.\nLong-press or 3D Touch.\nSee page without leaving." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معاينة الروابط قبل الفتح.\nالضغط المطول أو 3D Touch.\nعرض الصفحة دون المغادرة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previsualitza enllaços abans d'obrir.\nPremeu llarg o 3D Touch.\nVeieu la pàgina sense sortir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Náhled odkazů před otevřením.\nDlouhý stisk nebo 3D Touch.\nZobrazit stránku bez opuštění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forhåndsvis links før åbning.\nLangt tryk eller 3D Touch.\nSe side uden at forlade."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linkvorschau vor dem Öffnen.\nLanges Drücken oder 3D Touch.\nSeite ansehen ohne zu verlassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προεπισκόπηση συνδέσμων πριν το άνοιγμα.\nΠαρατεταμένο πάτημα ή 3D Touch.\nΔείτε τη σελίδα χωρίς να φύγετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vista previa de enlaces antes de abrir.\nPulsación larga o 3D Touch.\nVer la página sin salir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esikatsele linkkejä ennen avaamista.\nPitkä painallus tai 3D Touch.\nKatso sivu poistumatta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperçu des liens avant ouverture.\nAppui long ou 3D Touch.\nVoir la page sans quitter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תצוגה מקדימה של קישורים לפני פתיחה.\nלחיצה ארוכה או 3D Touch.\nצפה בדף מבלי לעזוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खोलने से पहले लिंक का पूर्वावलोकन करें।\nलंबे समय तक दबाएं या 3D Touch।\nबिना छोड़े पेज देखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregled poveznica prije otvaranja.\nDugi pritisak ili 3D Touch.\nPogledajte stranicu bez napuštanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link előnézet megnyitás előtt.\nHosszú nyomás vagy 3D Touch.\nOldal megtekintése távozás nélkül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratinjau tautan sebelum membuka.\nTekan lama atau 3D Touch.\nLihat halaman tanpa meninggalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteprima link prima di aprirli.\nPressione prolungata o 3D Touch.\nVedi la pagina senza uscire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクを開く前にプレビューします。\n長押しまたは3D Touchで表示します。\nページを離れずに確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링크를 열기 전에 미리볼 수 있습니다.\n길게 누르세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratonton pautan sebelum membuka.\nTekan lama atau 3D Touch.\nLihat halaman tanpa meninggalkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forhåndsvis lenker før åpning.\nLangt trykk eller 3D Touch.\nSe side uten å forlate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk links vooraf.\nLang indrukken of 3D Touch.\nBekijk pagina zonder te verlaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podgląd linków przed otwarciem.\nDługie naciśnięcie lub 3D Touch.\nZobacz stronę bez opuszczania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualizar links antes de abrir.\nToque longo ou 3D Touch.\nVer página sem sair."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pré-visualizar links antes de abrir.\nToque longo ou 3D Touch.\nVer página sem sair."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previzualizare linkuri înainte de deschidere.\nApăsare lungă sau 3D Touch.\nVedeți pagina fără a părăsi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предпросмотр ссылок перед открытием.\nДолгое нажатие или 3D Touch.\nПросмотр страницы без перехода."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Náhľad odkazov pred otvorením.\nDlhé stlačenie alebo 3D Touch.\nZobraziť stránku bez opustenia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förhandsgranska länkar innan öppning.\nLångt tryck eller 3D Touch.\nSe sida utan att lämna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูตัวอย่างลิงก์ก่อนเปิด\nกดค้างหรือ 3D Touch\nดูหน้าโดยไม่ต้องออก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açmadan önce bağlantı önizlemesi.\nUzun basma veya 3D Touch.\nAyrılmadan sayfayı görün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попередній перегляд посилань перед відкриттям.\nДовге натискання або 3D Touch.\nПерегляд сторінки без переходу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem trước liên kết trước khi mở.\nNhấn giữ hoặc 3D Touch.\nXem trang mà không cần rời đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开前预览链接。\n长按或3D Touch。\n无需离开即可查看页面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟前預覽連結。\n長按或3D Touch。\n無需離開即可查看頁面。"
          }
        }
      }
    },
