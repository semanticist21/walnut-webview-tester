    "Total device RAM.\nShared between system and apps.\niPhone: 4-8GB typically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إجمالي ذاكرة الجهاز.\nمشتركة بين النظام والتطبيقات.\niPhone: عادةً 4-8 جيجابايت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAM total del dispositiu.\nCompartida entre sistema i apps.\niPhone: Típicament 4-8GB."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celková RAM zařízení.\nSdílená mezi systémem a aplikacemi.\niPhone: Obvykle 4-8 GB."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total enheds-RAM.\nDelt mellem system og apps.\niPhone: Typisk 4-8GB."
