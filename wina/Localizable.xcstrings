    "Website cookies enabled.\nStores login sessions, preferences.\nPrivate mode clears on exit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملفات تعريف الارتباط للموقع مفعلة.\nتخزن جلسات تسجيل الدخول والتفضيلات.\nالوضع الخاص يمسح عند الخروج."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galetes del lloc web activades.\nEmmagatzema sessions d'inici de sessió, preferències.\nEl mode privat neteja en sortir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookies webu povoleny.\nUkládá přihlašovací relace, preference.\nSoukromý režim maže při ukončení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Website-cookies aktiveret.\nGemmer login-sessioner, præferencer.\nPrivat tilstand rydder ved afslutning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Website-Cookies aktiviert.\nSpeichert Login-Sitzungen, Einstellungen.\nPrivater Modus löscht beim Beenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookies ιστότοπου ενεργά.\nΑποθηκεύει συνεδρίες σύνδεσης, προτιμήσεις.\nΗ ιδιωτική λειτουργία καθαρίζει κατά την έξοδο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookies del sitio web habilitadas.\nAlmacena sesiones de inicio de sesión, preferencias.\nEl modo privado borra al salir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sivuston evästeet käytössä.\nTallentaa kirjautumisistunnot, asetukset.\nYksityinen tila tyhjentää lopetettaessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookies du site web activés.\nStocke les sessions de connexion, les préférences.\nLe mode privé efface à la sortie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עוגיות אתר מופעלות.\nשומר הפעלות כניסה, העדפות.\nמצב פרטי מנקה ביציאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वेबसाइट कुकीज़ सक्षम।\nलॉगिन सत्र, प्राथमिकताएँ संग्रहीत करता है।\nप्राइवेट मोड बाहर निकलने पर साफ़ करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolačići web stranice omogućeni.\nPohranjuje sesije prijave, postavke.\nPrivatni način briše pri izlasku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weboldal sütik engedélyezve.\nBejelentkezési munkamenetek, beállítások tárolása.\nPrivát mód kilépéskor töröl."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookie situs web diaktifkan.\nMenyimpan sesi login, preferensi.\nMode pribadi menghapus saat keluar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookie del sito web abilitati.\nMemorizza sessioni di accesso, preferenze.\nLa modalità privata cancella all'uscita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウェブサイトのCookieが有効です。\nログインセッションや設定を保存します。\nプライベートモードは終了時に削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹사이트 쿠키를 활성화합니다.\n로그인 세션과 설정을 저장합니다.\n비공개 모드는 종료 시 삭제됩니다."
