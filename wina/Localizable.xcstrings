        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safarin renderöintimoottori.\nJaettu kaikkien iOS-selainten kesken.\nPäivitetään iOS-julkaisujen yhteydessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moteur de rendu Safari.\nPartagé par tous les navigateurs iOS.\nMis à jour avec les versions iOS."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מנוע העיבוד של Safari.\nמשותף לכל דפדפני iOS.\nמתעדכן עם גרסאות iOS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari का रेंडरिंग इंजन।\nसभी iOS ब्राउज़र में साझा।\niOS रिलीज़ के साथ अपडेट।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safarijev motor za renderiranje.\nDijeli se među svim iOS preglednicima.\nAžurira se s iOS izdanjima."
          }
        },
        "hu" : {
          "stringUnit" : {
