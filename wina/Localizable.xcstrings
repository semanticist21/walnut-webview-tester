    "Force pinch-to-zoom.\nOverrides pages that disable zoom.\nBetter accessibility." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فرض التكبير بالقرص.\nيتجاوز الصفحات التي تعطل التكبير.\nإمكانية وصول أفضل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Força el zoom amb pinça.\nIgnora les pàgines que desactiven el zoom.\nMillor accessibilitat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vynutit přiblížení štípnutím.\nPřepíše stránky, které zoom zakazují.\nLepší přístupnost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tving knib-zoom.\nTilsidesætter sider, der deaktiverer zoom.\nBedre tilgængelighed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinch-Zoom erzwingen.\nÜberschreibt Seiten, die Zoom deaktivieren.\nBessere Barrierefreiheit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναγκαστική μεγέθυνση με τσίμπημα.\nΠαρακάμπτει σελίδες που απενεργοποιούν το ζουμ.\nΚαλύτερη προσβασιμότητα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forzar zoom con pellizco.\nIgnora páginas que deshabilitan el zoom.\nMejor accesibilidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakota nipistyszoomaus.\nOhittaa sivut, jotka estävät zoomauksen.\nParempi saavutettavuus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forcer le zoom par pincement.\nIgnore les pages qui désactivent le zoom.\nMeilleure accessibilité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הכרח זום בצביטה.\nמתעלם מדפים שמשביתים זום.\nנגישות משופרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिंच-टू-ज़ूम को बाध्य करें।\nज़ूम अक्षम करने वाले पृष्ठों को ओवरराइड करता है।\nबेहतर पहुंच।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisili zumiranje štipanjem.\nZanemari stranice koje onemogućuju zumiranje.\nBolja pristupačnost."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csípéses nagyítás kényszerítése.\nFelülírja azokat az oldalakat, amelyek letiltják a nagyítást.\nJobb akadálymentesség."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paksa zoom cubit.\nAbaikan halaman yang menonaktifkan zoom.\nAksesibilitas lebih baik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forza lo zoom pizzico.\nIgnora le pagine che disabilitano lo zoom.\nMigliore accessibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピンチズームを強制します。\nズーム無効化ページを上書きします。\nアクセシビリティが向上します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "핀치 줌을 강제합니다.\n줌 비활성화 페이지를 무시합니다.\n접근성이 향상됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paksa zum cubit.\nAbaikan halaman yang melumpuhkan zum.\nKebolehcapaian lebih baik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tving klyp-zoom.\nOverstyrer sider som deaktiverer zoom.\nBedre tilgjengelighet."
          }
        },
        "nl" : {
          "stringUnit" : {
