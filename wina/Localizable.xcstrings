    "Service Worker cache storage.\nData may clear after 7 days idle.\nGood for offline resources." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تخزين ذاكرة التخزين المؤقت لـ Service Worker.\nقد يتم مسح البيانات بعد 7 أيام من عدم النشاط.\nجيد للموارد غير المتصلة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emmagatzematge de memòria cau Service Worker.\nLes dades es poden esborrar després de 7 dies d'inactivitat.\nBo per a recursos fora de línia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úložiště cache Service Worker.\nData mohou být smazána po 7 dnech nečinnosti.\nDobré pro offline zdroje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Service Worker cache-lagring.\nData kan slettes efter 7 dages inaktivitet.\nGodt til offline-ressourcer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Service Worker-Cache-Speicher.\nDaten können nach 7 Tagen Inaktivität gelöscht werden.\nGut für Offline-Ressourcen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθήκευση cache Service Worker.\nΤα δεδομένα ενδέχεται να διαγραφούν μετά από 7 ημέρες αδράνειας.\nΚαλό για πόρους εκτός σύνδεσης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almacenamiento caché de Service Worker.\nLos datos pueden borrarse tras 7 días de inactividad.\nBueno para recursos sin conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Service Worker -välimuisti.\nTiedot voivat tyhjentyä 7 päivän käyttämättömyyden jälkeen.\nHyvä offline-resursseihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stockage cache Service Worker.\nLes données peuvent être effacées après 7 jours d'inactivité.\nIdéal pour les ressources hors ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אחסון מטמון Service Worker.\nנתונים עשויים להימחק לאחר 7 ימים ללא פעילות.\nטוב למשאבים לא מקוונים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Service Worker कैश स्टोरेज।\n7 दिनों की निष्क्रियता के बाद डेटा साफ़ हो सकता है।\nऑफ़लाइन संसाधनों के लिए अच्छा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohrana predmemorije Service Worker.\nPodaci se mogu izbrisati nakon 7 dana neaktivnosti.\nDobro za offline resurse."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Service Worker gyorsítótár.\nAz adatok törölhetők 7 nap inaktivitás után.\nJó offline erőforrásokhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyimpanan cache Service Worker.\nData dapat dihapus setelah 7 hari tidak aktif.\nBagus untuk sumber daya offline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiviazione cache Service Worker.\nI dati potrebbero essere cancellati dopo 7 giorni di inattività.\nBuono per risorse offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Service Workerキャッシュストレージです。\n7日間未使用でデータが削除される場合があります。\nオフラインリソースに最適です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Service Worker 캐시 저장소입니다.\n7일 미사용 시 삭제될 수 있습니다.\n오프라인 리소스에 적합합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storan cache Service Worker.\nData mungkin dipadam selepas 7 hari tidak aktif.\nBaik untuk sumber luar talian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Service Worker cache-lagring.\nData kan slettes etter 7 dager inaktivitet.\nBra for offline-ressurser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Service Worker cache-opslag.\nGegevens kunnen na 7 dagen inactiviteit worden gewist.\nGoed voor offline bronnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamięć podręczna Service Worker.\nDane mogą zostać usunięte po 7 dniach nieaktywności.\nDobre dla zasobów offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armazenamento de cache do Service Worker.\nDados podem ser apagados após 7 dias inativos.\nBom para recursos offline."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armazenamento de cache do Service Worker.\nOs dados podem ser apagados após 7 dias inativos.\nBom para recursos offline."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stocare cache Service Worker.\nDatele pot fi șterse după 7 zile de inactivitate.\nBun pentru resurse offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кэш-хранилище Service Worker.\nДанные могут удаляться после 7 дней бездействия.\nХорошо для офлайн-ресурсов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úložisko cache Service Worker.\nÚdaje môžu byť vymazané po 7 dňoch nečinnosti.\nDobré pre offline zdroje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Service Worker cache-lagring.\nData kan rensas efter 7 dagars inaktivitet.\nBra för offline-resurser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่เก็บแคช Service Worker\nข้อมูลอาจถูกล้างหลังจากไม่ได้ใช้งาน 7 วัน\nดีสำหรับทรัพยากรออฟไลน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Service Worker önbellek depolama.\nVeriler 7 gün boşta kaldıktan sonra silinebilir.\nÇevrimdışı kaynaklar için iyi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кеш-сховище Service Worker.\nДані можуть видалятися після 7 днів бездіяльності.\nДобре для офлайн-ресурсів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ nhớ cache Service Worker.\nDữ liệu có thể bị xóa sau 7 ngày không hoạt động.\nTốt cho tài nguyên ngoại tuyến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Service Worker 缓存存储。\n闲置 7 天后数据可能被清除。\n适合离线资源。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Service Worker 快取儲存。\n閒置 7 天後資料可能被清除。\n適合離線資源。"
          }
        }
      }
