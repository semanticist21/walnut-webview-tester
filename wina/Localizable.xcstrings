    "Safari's rendering engine.\nShared across all iOS browsers.\nUpdated with iOS releases." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محرك عرض Safari.\nمشترك بين جميع متصفحات iOS.\nيتم تحديثه مع إصدارات iOS."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motor de renderització de Safari.\nCompartit per tots els navegadors iOS.\nActualitzat amb les versions d'iOS."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykreslovací jádro Safari.\nSdílené všemi prohlížeči iOS.\nAktualizováno s verzemi iOS."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safaris renderingsmotor.\nDeles af alle iOS-browsere.\nOpdateres med iOS-udgivelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safaris Rendering-Engine.\nVon allen iOS-Browsern geteilt.\nWird mit iOS-Releases aktualisiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μηχανή απόδοσης Safari.\nΚοινή σε όλους τους browsers iOS.\nΕνημερώνεται με τις εκδόσεις iOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motor de renderizado de Safari.\nCompartido por todos los navegadores iOS.\nActualizado con las versiones de iOS."
