    "No history saved.\nCookies cleared on exit.\nLike incognito mode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتم حفظ السجل.\nيتم مسح ملفات تعريف الارتباط عند الخروج.\nمثل وضع التصفح المتخفي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sense historial desat.\nGaletes esborrades en sortir.\nCom el mode d'incògnit."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádná historie uložena.\nCookies smazány při ukončení.\nJako anonymní režim."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen historik gemt.\nCookies ryddes ved afslutning.\nSom inkognitotilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Verlauf gespeichert.\nCookies bei Beenden gelöscht.\nWie Inkognito-Modus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς αποθηκευμένο ιστορικό.\nΤα cookies διαγράφονται κατά την έξοδο.\nΣαν κατάσταση ανώνυμης περιήγησης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin historial guardado.\nCookies borradas al salir.\nComo modo incógnito."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historiaa ei tallenneta.\nEvästeet poistetaan sulkiessa.\nKuten incognito-tila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d'historique enregistré.\nCookies effacés à la fermeture.\nComme le mode incognito."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היסטוריה לא נשמרת.\nעוגיות נמחקות ביציאה.\nכמו מצב גלישה פרטית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई इतिहास नहीं सहेजा गया।\nबाहर निकलने पर कुकीज़ साफ़।\nइनकॉग्निटो मोड जैसा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema spremljene povijesti.\nKolačići se brišu pri izlasku.\nKao anonimni način."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs mentett előzmény.\nA sütik törlődnek kilépéskor.\nMint az inkognitó mód."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada riwayat tersimpan.\nCookie dihapus saat keluar.\nSeperti mode penyamaran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna cronologia salvata.\nCookie cancellati all'uscita.\nCome modalità incognito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴は保存されません。\n終了時にCookieがクリアされます。\nシークレットモードのようなものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록을 저장하지 않습니다.\n시크릿 모드와 비슷합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada sejarah disimpan.\nKuki dikosongkan semasa keluar.\nSeperti mod incognito."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen historikk lagret.\nInformasjonskapsler slettes ved avslutning.\nSom inkognitomodus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen geschiedenis opgeslagen.\nCookies gewist bij afsluiten.\nZoals incognitomodus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez zapisanej historii.\nCiasteczka czyszczone przy wyjściu.\nJak tryb incognito."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem histórico salvo.\nCookies apagados ao sair.\nComo modo anônimo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem histórico guardado.\nCookies apagados ao sair.\nComo modo incógnito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niciun istoric salvat.\nCookie-urile sunt șterse la ieșire.\nCa modul incognito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История не сохраняется.\nCookie очищаются при выходе.\nКак режим инкогнито."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žiadna história uložená.\nCookies vymazané pri ukončení.\nAko anonymný režim."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen historik sparad.\nKakor rensas vid avslut.\nSom inkognitoläge."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่บันทึกประวัติ\nล้าง Cookie เมื่อออก\nเหมือนโหมดไม่ระบุตัวตน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmiş kaydedilmez.\nÇıkışta çerezler temizlenir.\nGizli mod gibi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Історія не зберігається.\nCookie видаляються при виході.\nЯк режим інкогніто."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không lưu lịch sử.\nXóa cookie khi thoát.\nGiống chế độ ẩn danh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不保存历史记录。\n退出时清除Cookie。\n类似无痕模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不儲存歷史記錄。\n退出時清除Cookie。\n類似無痕模式。"
          }
        }
      }
    },
