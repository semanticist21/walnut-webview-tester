    },
    "Website data is sandboxed per app. Data stored in one app is not accessible from another." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بيانات الموقع معزولة لكل تطبيق. البيانات المخزنة في تطبيق واحد لا يمكن الوصول إليها من تطبيق آخر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dades del lloc web estan aïllades per aplicació. Les dades emmagatzemades en una app no són accessibles des d'una altra."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data webu jsou izolována pro každou aplikaci. Data uložená v jedné aplikaci nejsou přístupná z jiné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websitedata er isoleret pr. app. Data gemt i en app er ikke tilgængelig fra en anden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Website-Daten sind pro App in einer Sandbox. In einer App gespeicherte Daten sind von einer anderen nicht zugänglich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα δεδομένα ιστότοπου είναι απομονωμένα ανά εφαρμογή. Δεδομένα που αποθηκεύονται σε μια εφαρμογή δεν είναι προσβάσιμα από άλλη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos del sitio web están aislados por aplicación. Los datos almacenados en una app no son accesibles desde otra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sivuston tiedot on eristetty sovelluskohtaisesti. Yhdessä sovelluksessa tallennetut tiedot eivät ole käytettävissä toisessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données du site web sont isolées par application. Les données stockées dans une application ne sont pas accessibles depuis une autre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נתוני אתר מבודדים לכל אפליקציה. נתונים המאוחסנים באפליקציה אחת אינם נגישים מאפליקציה אחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वेबसाइट डेटा प्रति ऐप सैंडबॉक्स्ड है। एक ऐप में संग्रहीत डेटा दूसरे से एक्सेस नहीं किया जा सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podaci web stranice su izolirani po aplikaciji. Podaci pohranjeni u jednoj aplikaciji nisu dostupni iz druge."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A weboldal adatai alkalmazásonként elkülönítettek. Az egyik alkalmazásban tárolt adatok nem érhetők el a másikból."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data situs web terisolasi per aplikasi. Data yang disimpan di satu aplikasi tidak dapat diakses dari aplikasi lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati del sito web sono isolati per app. I dati memorizzati in un'app non sono accessibili da un'altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウェブサイトのデータはアプリごとにサンドボックス化されます。あるアプリに保存されたデータは別のアプリからアクセスできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹사이트 데이터는 앱별로 분리됩니다. 다른 앱에서는 접근할 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data laman web diasingkan mengikut aplikasi. Data yang disimpan dalam satu aplikasi tidak boleh diakses dari yang lain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettsteddata er isolert per app. Data lagret i en app er ikke tilgjengelig fra en annen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websitegegevens zijn per app geïsoleerd. Gegevens opgeslagen in een app zijn niet toegankelijk vanuit een andere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane strony są izolowane dla każdej aplikacji. Dane zapisane w jednej aplikacji nie są dostępne z innej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados do site são isolados por aplicativo. Dados armazenados em um app não são acessíveis de outro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados do site são isolados por aplicação. Dados armazenados numa app não são acessíveis de outra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datele site-ului sunt izolate per aplicație. Datele stocate într-o aplicație nu sunt accesibile din alta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные веб-сайта изолированы для каждого приложения. Данные, сохранённые в одном приложении, недоступны из другого."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Údaje webu sú izolované pre každú aplikáciu. Údaje uložené v jednej aplikácii nie sú prístupné z inej."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Webbplatsdata är isolerad per app. Data lagrad i en app är inte åtkomlig från en annan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลเว็บไซต์ถูกแยกตามแอป ข้อมูลที่เก็บในแอปหนึ่งไม่สามารถเข้าถึงจากแอปอื่นได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web sitesi verileri uygulama başına izole edilir. Bir uygulamada saklanan verilere başka bir uygulamadan erişilemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дані веб-сайту ізольовані для кожного додатку. Дані, збережені в одному додатку, недоступні з іншого."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu trang web được cách ly theo ứng dụng. Dữ liệu được lưu trữ trong một ứng dụng không thể truy cập từ ứng dụng khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网站数据按应用隔离。一个应用中存储的数据无法被另一个应用访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "網站資料依應用程式隔離。一個應用程式中儲存的資料無法被另一個應用程式存取。"
          }
        }
      }
    },
