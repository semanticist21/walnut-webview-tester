    "Each SFSafariViewController instance has separate storage. Closing and reopening clears session." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل مثيل SFSafariViewController له تخزين منفصل. الإغلاق وإعادة الفتح يمسح الجلسة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada instància de SFSafariViewController té emmagatzematge separat. Tancar i reobrir esborra la sessió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá instance SFSafariViewController má oddělené úložiště. Zavření a znovuotevření vymaže relaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver SFSafariViewController-instans har separat lager. Lukning og genåbning rydder sessionen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede SFSafariViewController-Instanz hat separaten Speicher. Schließen und erneutes Öffnen löscht die Sitzung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε παρουσία SFSafariViewController έχει ξεχωριστό χώρο αποθήκευσης. Το κλείσιμο και άνοιγμα καθαρίζει τη συνεδρία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada instancia de SFSafariViewController tiene almacenamiento separado. Cerrar y reabrir borra la sesión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokaisella SFSafariViewController-instanssilla on erillinen tallennustila. Sulkeminen ja avaaminen tyhjentää istunnon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque instance SFSafariViewController a un stockage séparé. Fermer et rouvrir efface la session."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לכל מופע SFSafariViewController אחסון נפרד. סגירה ופתיחה מחדש מוחקת את ההפעלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक SFSafariViewController इंस्टेंस का अलग स्टोरेज होता है। बंद करके फिर से खोलने पर सेशन साफ़ हो जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaka SFSafariViewController instanca ima zasebnu pohranu. Zatvaranje i ponovno otvaranje briše sesiju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden SFSafariViewController példánynak külön tárhelye van. Bezárás és újranyitás törli a munkamenetet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap instance SFSafariViewController memiliki penyimpanan terpisah. Menutup dan membuka kembali menghapus sesi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni istanza SFSafariViewController ha storage separato. Chiudere e riaprire cancella la sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SFSafariViewControllerはインスタンスごとにストレージが分離。閉じて開くとセッションがクリアされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SFSafariViewController는 인스턴스마다 저장소가 따로입니다. 닫았다 열면 세션이 사라집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap instance SFSafariViewController mempunyai storan berasingan. Menutup dan membuka semula mengosongkan sesi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver SFSafariViewController-instans har separat lagring. Lukking og gjenåpning sletter økten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke SFSafariViewController-instantie heeft aparte opslag. Sluiten en heropenen wist de sessie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda instancja SFSafariViewController ma oddzielną pamięć. Zamknięcie i ponowne otwarcie czyści sesję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada instância do SFSafariViewController tem armazenamento separado. Fechar e reabrir limpa a sessão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada instância do SFSafariViewController tem armazenamento separado. Fechar e reabrir limpa a sessão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare instanță SFSafariViewController are stocare separată. Închiderea și redeschiderea șterge sesiunea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый экземпляр SFSafariViewController имеет отдельное хранилище. Закрытие и повторное открытие очищает сессию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá inštancia SFSafariViewController má oddelené úložisko. Zatvorenie a znovuotvorenie vymaže reláciu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje SFSafariViewController-instans har separat lagring. Stängning och återöppning rensar sessionen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แต่ละ SFSafariViewController มีที่เก็บข้อมูลแยก ปิดแล้วเปิดใหม่จะล้างเซสชัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her SFSafariViewController örneği ayrı depolamaya sahiptir. Kapatıp yeniden açmak oturumu temizler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен екземпляр SFSafariViewController має окреме сховище. Закриття та повторне відкриття очищає сесію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi instance SFSafariViewController có bộ nhớ riêng. Đóng và mở lại sẽ xóa phiên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SFSafariViewController每个实例存储独立。关闭再打开会清除会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SFSafariViewController每個實例儲存獨立。關閉再開啟會清除工作階段。"
          }
        }
      }
    },
