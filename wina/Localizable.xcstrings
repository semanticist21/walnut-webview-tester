    "Gyroscope data access.\nalpha/beta/gamma rotation.\niOS 13+: User permission needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوصول إلى بيانات الجيروسكوب.\nدوران alpha/beta/gamma.\niOS 13+: يتطلب إذن المستخدم."
