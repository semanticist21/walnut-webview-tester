    "Mobile or desktop sites.\nRecommended: Auto-detect.\nDesktop useful on iPad." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مواقع الجوال أو سطح المكتب.\nموصى به: كشف تلقائي.\nسطح المكتب مفيد على iPad."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llocs mòbils o d'escriptori.\nRecomanat: Auto-detecció.\nEscriptori útil a iPad."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobilní nebo desktopové stránky.\nDoporučeno: Automatická detekce.\nDesktop užitečný na iPadu."
