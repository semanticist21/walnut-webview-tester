        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innstillinger > Tilgjengelighet > Skjerm.\nInverterer alle skjermfarger.\nCSS: alternativ til prefers-color-scheme."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instellingen > Toegankelijkheid > Beeldscherm.\nKeert alle schermkleuren om.\nCSS: alternatief voor prefers-color-scheme."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia > Dostępność > Wyświetlacz.\nOdwraca wszystkie kolory ekranu.\nCSS: alternatywa dla prefers-color-scheme."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes > Acessibilidade > Tela.\nInverte todas as cores da tela.\nCSS: alternativa ao prefers-color-scheme."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definições > Acessibilidade > Ecrã.\nInverte todas as cores do ecrã.\nCSS: alternativa ao prefers-color-scheme."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setări > Accesibilitate > Afișaj.\nInversează toate culorile ecranului.\nCSS: alternativă la prefers-color-scheme."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки > Универсальный доступ > Дисплей.\nИнвертирует все цвета экрана.\nCSS: альтернатива prefers-color-scheme."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavenia > Prístupnosť > Displej.\nInvertuje všetky farby obrazovky.\nCSS: alternatíva k prefers-color-scheme."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inställningar > Tillgänglighet > Bildskärm.\nInverterar alla skärmfärger.\nCSS: alternativ till prefers-color-scheme."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งค่า > การช่วยการเข้าถึง > จอภาพ\nกลับสีหน้าจอทั้งหมด\nCSS: ทางเลือกแทน prefers-color-scheme"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar > Erişilebilirlik > Ekran.\nTüm ekran renklerini tersine çevirir.\nCSS: prefers-color-scheme alternatifi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштування > Доступність > Дисплей.\nІнвертує всі кольори екрана.\nCSS: альтернатива prefers-color-scheme."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt > Trợ năng > Màn hình.\nĐảo ngược tất cả màu sắc màn hình.\nCSS: thay thế prefers-color-scheme."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置 > 辅助功能 > 显示。\n反转所有屏幕颜色。\nCSS: prefers-color-scheme 替代方案。"
          }
