    "Ultra-wide gamut (~75% of visible).\nPro Display XDR, some iPad Pro.\niPhone: Not supported yet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نطاق لوني فائق العرض (~75% من المرئي).\nPro Display XDR، بعض iPad Pro.\niPhone: غير مدعوم بعد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamma ultraampli (~75% del visible).\nPro Display XDR, alguns iPad Pro.\niPhone: Encara no compatible."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultra-široká barevná škála (~75% viditelného).\nPro Display XDR, některé iPad Pro.\niPhone: Zatím nepodporováno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultra-bred farveskala (~75% af synligt).\nPro Display XDR, nogle iPad Pro.\niPhone: Ikke understøttet endnu."
          }
        },
        "de" : {
          "stringUnit" : {
