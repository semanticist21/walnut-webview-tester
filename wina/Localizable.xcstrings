          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armazenamento chave-valor persistente.\nLimite de aproximadamente 5MB por site.\nPersiste após reinicialização do navegador."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
